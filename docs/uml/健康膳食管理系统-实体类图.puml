@startuml 健康膳食管理系统-实体类图
' 依据：backend/app/models 与 config.autoMigrate() 实际注册实体
' 说明：init.sql 中的 plan_ingredient_rel 未纳入 GORM AutoMigrate，运行期未作为实体管理，故不画入
' 约定：本图仅属性与关联，不写业务方法（论文中可与边界类/控制类图区分）

skinparam class {
    BackgroundColor #f9f9f9
    BorderColor #333333
    FontName "Microsoft YaHei"
}
skinparam package {
    BackgroundColor #e6f7ff
    FontName "Microsoft YaHei"
}
skinparam ArrowColor #333333
left to right direction

package "账户与身份" {
    class 用户 <<实体>> {
        - 用户ID
        - 用户名
        - 姓名
        - 登录密码
        - 手机号
        - 性别
        - 年龄
        - 邮箱
        - 角色类型
        - 账号状态
        - 创建时间
        - 更新时间
    }

    class 规划师账号 <<实体>> {
        - 账号ID
        - 用户名
        - 姓名
        - 登录密码
        - 角色类型
        - 职称
        - 专长
        - 简介
        - 联系方式
        - 当前服务用户数
        - 历史服务用户数
        - 历史平均评分
        - 评分次数
        - 账号状态
        - 创建时间
        - 更新时间
    }
}

package "健康数据" {
    class 健康数据 <<实体>> {
        - 数据ID
        - 用户ID
        - 性别
        - 年龄
        - 身高
        - 体重
        - 心率
        - 血压
        - 血糖
        - 过敏史
        - 活动水平
        - 营养目标
        - 创建时间
        - 更新时间
    }

    class 健康数据历史 <<实体>> {
        - 历史ID
        - 数据ID
        - 用户ID
        - 性别
        - 年龄
        - 身高
        - 体重
        - 心率
        - 血压
        - 血糖
        - 过敏史
        - 活动水平
        - 营养目标
        - 来源
        - 快照时间
        - 创建时间
    }
}

package "服务与评估" {
    class 服务请求 <<实体>> {
        - 请求ID
        - 用户ID
        - 规划师ID
        - 服务类型
        - 膳食目标
        - 其他目标
        - 健康数据快照
        - 状态
        - 创建时间
        - 更新时间
    }

    class 营养评估 <<实体>> {
        - 评估ID
        - 用户ID
        - 规划师ID
        - 服务请求ID
        - 来源
        - 状态
        - BMI
        - 能量需求千卡
        - 营养状况摘要
        - 体成分分析文本
        - 膳食模式文本
        - 微量营养素文本
        - 风险文本
        - 优先问题JSON
        - 专业结论
        - 计划建议
        - 输入快照JSON
        - 有效期至
        - 创建时间
        - 更新时间
    }
}

package "膳食计划结构" {
    class 膳食计划 <<实体>> {
        - 计划ID
        - 用户ID
        - 服务请求ID
        - 规划师ID
        - 计划标题
        - 来源
        - 膳食目标
        - 周期天数
        - 审核状态
        - 审核意见
        - 审核人
        - 审核时间
        - 发布时间
        - 更新时间
    }

    class 计划日 <<实体>> {
        - 日计划ID
        - 计划ID
        - 天序号
        - 计划日期
        - 热量
        - 蛋白质
        - 碳水化合物
        - 脂肪
    }

    class 餐次 <<实体>> {
        - 餐次ID
        - 日计划ID
        - 餐次类型
        - 时间
        - 热量
        - 蛋白质
        - 碳水化合物
        - 脂肪
        - 是否已执行
    }

    class 食物 <<实体>> {
        - 食物ID
        - 餐次ID
        - 名称
        - 份量描述
        - 热量
        - 蛋白质
        - 碳水化合物
        - 脂肪
    }

}

package "营养摄入记录" {
    class 营养记录 <<实体>> {
        - 记录ID
        - 用户ID
        - 用餐日期
        - 餐次类型
        - 总热量
        - 总蛋白质
        - 总碳水化合物
        - 总脂肪
        - 总膳食纤维
        - 创建时间
        - 更新时间
    }

    class 营养记录明细 <<实体>> {
        - 明细ID
        - 记录ID
        - 食物名称
        - 用量
        - 单位
        - 每单位克数
        - 热量
        - 蛋白质
        - 碳水化合物
        - 脂肪
        - 膳食纤维
    }
}

package "食材库" {
    class 食材 <<实体>> {
        - 食材ID
        - 名称
        - 分类
        - 每百克热量
        - 每百克营养JSON
        - 常用单位
        - 每单位克数
        - 可见范围
        - 所有者用户ID
        - 来源类型
        - 来源工单ID
        - 审核状态
        - 风险等级
        - 风险分值
        - 启用状态
        - 创建时间
        - 更新时间
    }

    class 食材提交工单 <<实体>> {
        - 工单ID
        - 用户ID
        - 内部食材ID
        - 提交名称
        - 提交分类
        - 提交每百克热量
        - 提交每百克营养
        - 提交单位
        - 提交每单位克数
        - 自动推算热量
        - 自动偏差比
        - 自动校验结果
        - 流程状态
        - 审核人ID
        - 审核备注
        - 创建时间
        - 更新时间
    }
}

package "反馈与健康教育" {
    class 用户反馈 <<实体>> {
        - 反馈ID
        - 用户ID
        - 分类
        - 标题
        - 内容
        - 评分
        - 关联计划ID
        - 对象规划师ID
        - 状态
        - 首次回复时间
        - 关闭时间
        - 创建时间
        - 更新时间
    }

    class 反馈回复 <<实体>> {
        - 回复ID
        - 反馈ID
        - 发送方类型
        - 发送方用户ID
        - 正文
        - 创建时间
    }

    class 健康教育 <<实体>> {
        - 内容ID
        - 规划师ID
        - 标题
        - 摘要
        - 正文
        - 分类
        - 可见性
        - 目标用户ID列表
        - 内容状态
        - 审核状态
        - 审核意见
        - 创建时间
        - 更新时间
    }
}

' ---------- 关联（逻辑外键与 GORM 组合关系）----------

用户 "1" --> "n" 健康数据 : 建档
用户 "1" *-- "n" 健康数据历史 : 变更快照

用户 "1" --> "n" 服务请求 : 发起
规划师账号 "1" --> "n" 服务请求 : 承接

用户 "1" --> "n" 营养评估 : 被评估
规划师账号 "1" --> "n" 营养评估 : 出具
服务请求 "0..1" <-- "n" 营养评估 : 可选关联

用户 "1" --> "n" 膳食计划 : 所属
规划师账号 "1" --> "n" 膳食计划 : 制定
服务请求 "0..1" <-- "n" 膳食计划 : 可选来源

膳食计划 "1" *-- "n" 计划日 : 包含
计划日 "1" *-- "n" 餐次 : 包含
餐次 "1" *-- "n" 食物 : 包含

用户 "1" --> "n" 营养记录 : 录入
营养记录 "1" *-- "n" 营养记录明细 : 明细

用户 "1" --> "n" 食材提交工单 : 提交
食材提交工单 ..> 食材 : 核准后入库\n(逻辑关联)

用户 "1" --> "n" 用户反馈 : 提交
用户反馈 "1" *-- "n" 反馈回复 : 对话
用户反馈 ..> 膳食计划 : 可选关联计划
用户反馈 ..> 规划师账号 : 可选对象

规划师账号 "1" --> "n" 健康教育 : 发布

note bottom of 食材
  运行期未与「食物」「营养记录明细」
  建立数据库外键；前端选食材后
  以名称与营养数值快照落库。
  plan_execution 表未接入业务；
  计划餐次是否执行由 meals.executed 维护。
end note

@enduml
