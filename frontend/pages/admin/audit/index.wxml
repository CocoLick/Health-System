<view class="audit-center">
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'plans' ? 'active' : ''}}" bindtap="switchTab" data-tab="plans">
      <text class="tab-text">膳食计划审核</text>
    </view>
    <view class="tab-item {{activeTab === 'articles' ? 'active' : ''}}" bindtap="switchTab" data-tab="articles">
      <text class="tab-text">健康文章审核</text>
    </view>
    <view class="tab-item {{activeTab === 'ingredients' ? 'active' : ''}}" bindtap="switchTab" data-tab="ingredients">
      <text class="tab-text">食材新增</text>
    </view>
    <view class="tab-item {{activeTab === 'history' ? 'active' : ''}}" bindtap="switchTab" data-tab="history">
      <text class="tab-text">审核历史</text>
    </view>
  </view>

  <!-- 膳食计划审核 -->
  <view wx:if="{{activeTab === 'plans'}}" class="audit-content">
    <view wx:if="{{planLoading}}" class="empty-state">
      <text class="empty-text">加载中...</text>
    </view>
    <view wx:for="{{pendingPlans}}" wx:key="index" class="audit-item">
      <view class="item-header">
        <text class="item-title">{{item.title}}</text>
        <text class="item-status">待审核</text>
      </view>
      <view class="item-body">
        <view class="item-info">
          <text class="info-label">用户：</text>
          <text class="info-value">{{item.user}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">规划师：</text>
          <text class="info-value">{{item.dietitian}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">饮食目标：</text>
          <text class="info-value">{{item.goal}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">提交时间：</text>
          <text class="info-value">{{item.submitTime}}</text>
        </view>
      </view>
      <view class="item-footer">
        <view class="btn-primary" bindtap="approvePlan" data-id="{{item.id}}">通过</view>
        <view class="btn-secondary" bindtap="rejectPlan" data-id="{{item.id}}">驳回</view>
        <view class="btn-text" bindtap="viewPlanDetail" data-item="{{item}}">查看详情</view>
      </view>
    </view>
    <view wx:if="{{planHint}}" class="empty-state">
      <text class="empty-text">{{planHint}}</text>
    </view>
    <view wx:if="{{!planLoading && !planHint && pendingPlans.length === 0}}" class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无待审核的膳食计划</text>
    </view>
  </view>

  <!-- 健康文章审核 -->
  <view wx:if="{{activeTab === 'articles'}}" class="audit-content">
    <view wx:if="{{articleLoading}}" class="empty-state">
      <text class="empty-text">加载中...</text>
    </view>
    <view wx:for="{{pendingArticles}}" wx:key="index" class="audit-item">
      <view class="item-header">
        <text class="item-title">{{item.title}}</text>
        <text class="item-status">{{item.statusLabel}}</text>
      </view>
      <view class="item-body">
        <view class="item-info">
          <text class="info-label">规划师：</text>
          <text class="info-value">{{item.dietitian}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">分类：</text>
          <text class="info-value">{{item.category}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">提交时间：</text>
          <text class="info-value">{{item.submitTime}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">可见范围：</text>
          <text class="info-value">{{item.visibilityLabel}}</text>
        </view>
        <view class="article-preview">
          <text class="preview-text">{{item.preview}}</text>
        </view>
      </view>
      <view class="item-footer">
        <view class="btn-primary" bindtap="approveArticle" data-id="{{item.he_id}}">通过</view>
        <view class="btn-secondary" bindtap="rejectArticle" data-id="{{item.he_id}}">驳回</view>
        <view class="btn-text" bindtap="viewArticleDetail" data-item="{{item}}">查看详情</view>
      </view>
    </view>
    <view wx:if="{{articleHint}}" class="empty-state">
      <text class="empty-text">{{articleHint}}</text>
    </view>
    <view wx:if="{{!articleLoading && !articleHint && pendingArticles.length === 0}}" class="empty-state">
      <text class="empty-icon">📄</text>
      <text class="empty-text">暂无待审核的健康文章</text>
    </view>
  </view>

  <!-- 审核历史 -->
  <view wx:if="{{activeTab === 'history'}}" class="audit-content">
    <view class="history-filter">
      <picker bindchange="bindFilterChange" range="{{filterOptions}}" value="{{filterIndex}}">
        <view class="filter-btn">
          <text class="filter-text">{{filterOptions[filterIndex]}}</text>
          <text class="filter-icon">▼</text>
        </view>
      </picker>
    </view>
    <view wx:for="{{auditHistory}}" wx:key="index" class="audit-item">
      <view class="item-header">
        <text class="item-title">{{item.title}}</text>
        <text class="item-status {{item.status === '通过' ? 'status-approved' : 'status-rejected'}}">{{item.status}}</text>
      </view>
      <view class="item-body">
        <view class="item-info">
          <text class="info-label">类型：</text>
          <text class="info-value">{{item.type}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">审核人：</text>
          <text class="info-value">{{item.auditor}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">审核时间：</text>
          <text class="info-value">{{item.auditTime}}</text>
        </view>
        <view wx:if="{{item.reason}}" class="reject-reason">
          <text class="reason-label">驳回原因：</text>
          <text class="reason-text">{{item.reason}}</text>
        </view>
      </view>
      <view class="item-footer">
        <view class="btn-text" bindtap="viewAuditDetail" data-index="{{index}}">查看详情</view>
      </view>
    </view>
    <view wx:if="{{auditHistory.length === 0}}" class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无审核历史记录</text>
    </view>
  </view>

  <!-- 用户新增食材审核 -->
  <view wx:if="{{activeTab === 'ingredients'}}" class="audit-content">
    <view wx:if="{{ingredientLoading}}" class="empty-state">
      <text class="empty-text">加载中...</text>
    </view>
    <view wx:for="{{ingredientSubmissions}}" wx:key="submission_id" class="audit-item">
      <view class="item-header">
        <text class="item-title">{{item.submitted_name}}</text>
        <text class="item-status risk-{{item.auto_check_result}}">{{item.riskText}}</text>
      </view>
      <view class="item-body">
        <view class="item-info">
          <text class="info-label">类别：</text>
          <text class="info-value">{{item.submitted_category}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">提交人：</text>
          <text class="info-value">{{item.user_id}}</text>
        </view>
        <view class="item-info">
          <text class="info-label">热量：</text>
          <text class="info-value">{{item.submitted_calories_per_100g}} kcal/100g</text>
        </view>
        <view class="item-info">
          <text class="info-label">风险/偏差：</text>
          <text class="info-value">{{item.riskText}} · {{item.deltaPct}}</text>
        </view>
      </view>
      <view class="item-footer">
        <view class="btn-primary" bindtap="approveIngredient" data-id="{{item.submission_id}}">通过</view>
        <view class="btn-secondary" bindtap="returnIngredient" data-id="{{item.submission_id}}">退回</view>
        <view class="btn-text" bindtap="viewIngredientDetail" data-item="{{item}}">查看详情</view>
      </view>
    </view>
    <view wx:if="{{!ingredientLoading && ingredientSubmissions.length === 0}}" class="empty-state">
      <text class="empty-icon">🥗</text>
      <text class="empty-text">暂无待审核食材</text>
    </view>
  </view>

  <view wx:if="{{showIngredientDetailModal}}" class="audit-modal-mask" bindtap="hideIngredientDetailModal">
    <view class="audit-modal-card" catchtap="noop">
      <view class="audit-modal-head">
        <text class="audit-modal-title">食材提交详情</text>
        <view class="audit-modal-close" bindtap="hideIngredientDetailModal">×</view>
      </view>
      <view class="audit-modal-body">
        <view class="item-info"><text class="info-label">食材：</text><text class="info-value">{{selectedIngredientSubmission.submitted_name}}</text></view>
        <view class="item-info"><text class="info-label">类别：</text><text class="info-value">{{selectedIngredientSubmission.submitted_category}}</text></view>
        <view class="item-info"><text class="info-label">提交人：</text><text class="info-value">{{selectedIngredientSubmission.user_id}}</text></view>
        <view class="item-info"><text class="info-label">热量：</text><text class="info-value">{{selectedIngredientSubmission.submitted_calories_per_100g}} kcal/100g</text></view>
        <view class="item-info"><text class="info-label">蛋白质：</text><text class="info-value">{{selectedIngredientSubmission.submitted_nutrition_100g.protein}} g/100g</text></view>
        <view class="item-info"><text class="info-label">碳水：</text><text class="info-value">{{selectedIngredientSubmission.submitted_nutrition_100g.carbohydrate}} g/100g</text></view>
        <view class="item-info"><text class="info-label">脂肪：</text><text class="info-value">{{selectedIngredientSubmission.submitted_nutrition_100g.fat}} g/100g</text></view>
        <view class="item-info"><text class="info-label">单位：</text><text class="info-value">{{selectedIngredientSubmission.submitted_unit}}，每单位{{selectedIngredientSubmission.submitted_gram_per_unit}}g</text></view>
        <view class="item-info"><text class="info-label">估算热量：</text><text class="info-value">{{selectedIngredientSubmission.auto_calc_calories}} kcal/100g</text></view>
        <view class="item-info"><text class="info-label">风险/偏差：</text><text class="info-value">{{selectedIngredientSubmission.riskText}} · {{selectedIngredientSubmission.deltaPct}}</text></view>
        <view class="item-info"><text class="info-label">提交时间：</text><text class="info-value">{{selectedIngredientSubmission.submitTimeText}}</text></view>
      </view>
      <view class="item-footer">
        <view class="btn-secondary" bindtap="hideIngredientDetailModal">关闭</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showArticleDetailModal}}" class="audit-modal-mask" bindtap="hideArticleDetailModal">
    <view class="audit-modal-card" catchtap="noop">
      <view class="audit-modal-head">
        <text class="audit-modal-title">健康文章详情</text>
        <view class="audit-modal-close" bindtap="hideArticleDetailModal">×</view>
      </view>
      <view class="audit-modal-body">
        <view class="item-info"><text class="info-label">标题：</text><text class="info-value">{{selectedArticle.title}}</text></view>
        <view class="item-info"><text class="info-label">规划师：</text><text class="info-value">{{selectedArticle.dietitian}}</text></view>
        <view class="item-info"><text class="info-label">分类：</text><text class="info-value">{{selectedArticle.category}}</text></view>
        <view class="item-info"><text class="info-label">范围：</text><text class="info-value">{{selectedArticle.visibilityLabel}}</text></view>
        <view class="item-info"><text class="info-label">提交时间：</text><text class="info-value">{{selectedArticle.submitTime}}</text></view>
        <view class="item-info"><text class="info-label">摘要：</text><text class="info-value">{{selectedArticle.summary}}</text></view>
        <view class="item-info"><text class="info-label">正文：</text><text class="info-value">{{selectedArticle.body}}</text></view>
      </view>
      <view class="item-footer">
        <view class="btn-secondary" bindtap="hideArticleDetailModal">关闭</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showPlanDetailModal}}" class="audit-modal-mask" bindtap="hidePlanDetailModal">
    <view class="audit-modal-card" catchtap="noop">
      <view class="audit-modal-head">
        <text class="audit-modal-title">膳食计划详情</text>
        <view class="audit-modal-close" bindtap="hidePlanDetailModal">×</view>
      </view>
      <view class="audit-modal-body">
        <view class="item-info"><text class="info-label">标题：</text><text class="info-value">{{selectedPlanDetail.title}}</text></view>
        <view class="item-info"><text class="info-label">用户ID：</text><text class="info-value">{{selectedPlanDetail.user_id}}</text></view>
        <view class="item-info"><text class="info-label">规划师：</text><text class="info-value">{{selectedPlanDetail.dietitian_name || selectedPlanDetail.dietitian_id || '-'}}</text></view>
        <view class="item-info"><text class="info-label">目标：</text><text class="info-value">{{selectedPlanDetail.goal || '-'}}</text></view>
        <view class="item-info"><text class="info-label">周期：</text><text class="info-value">{{selectedPlanDetail.cycle_days}} 天</text></view>
        <view class="item-info"><text class="info-label">提交时间：</text><text class="info-value">{{selectedPlanDetail.update_time}}</text></view>
        <view class="item-info"><text class="info-label">状态：</text><text class="info-value">{{selectedPlanDetail.status}}</text></view>
        <view class="item-info"><text class="info-label">驳回原因：</text><text class="info-value">{{selectedPlanDetail.audit_note || '—'}}</text></view>

        <view wx:for="{{selectedPlanDetail.plan_days}}" wx:key="id" class="article-preview">
          <text class="preview-text">第{{item.day_index}}天 {{item.date}} · {{item.calories}} kcal</text>
          <view wx:for="{{item.meals}}" wx:key="id" class="item-info">
            <text class="info-label">{{item.type}}：</text>
            <text class="info-value">{{item.time}} · {{item.calories}} kcal</text>
          </view>
        </view>
      </view>
      <view class="item-footer">
        <view class="btn-secondary" bindtap="hidePlanDetailModal">关闭</view>
      </view>
    </view>
  </view>
</view>