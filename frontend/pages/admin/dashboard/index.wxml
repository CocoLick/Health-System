<view class="admin-dashboard">
  <view class="dashboard-header">
    <text class="dashboard-title">管理员工作台</text>
    <view class="user-info" bindtap="showPersonalCenter">
      <text class="welcome-text">欢迎，管理员</text>
      <view class="user-avatar">管</view>
    </view>
  </view>

  <view class="custom-tab-bar">
    <view class="tab-item {{activeTab === 'home' ? 'active' : ''}}" bindtap="switchTab" data-tab="home">
      <text class="tab-icon">🏠</text>
      <text class="tab-text">工作台首页</text>
    </view>
    <view class="tab-item {{activeTab === 'audit' ? 'active' : ''}}" bindtap="switchTab" data-tab="audit">
      <text class="tab-icon">✅</text>
      <text class="tab-text">审核中心</text>
    </view>
    <view class="tab-item {{activeTab === 'manage' ? 'active' : ''}}" bindtap="switchTab" data-tab="manage">
      <text class="tab-icon">⚙️</text>
      <text class="tab-text">管理中心</text>
    </view>
    <view class="tab-item {{activeTab === 'statistics' ? 'active' : ''}}" bindtap="switchTab" data-tab="statistics">
      <text class="tab-icon">📊</text>
      <text class="tab-text">统计中心</text>
    </view>
  </view>

  <view class="tab-content">
    <!-- 工作台首页 -->
    <view wx:if="{{activeTab === 'home'}}" class="content-panel">
      <view class="stats-overview">
        <view class="stat-card">
          <view class="stat-icon user-icon">👥</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.userCount || 0}}</text>
            <text class="stat-label">总用户数</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon dietitian-icon">👨‍⚕️</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.dietitianCount || 0}}</text>
            <text class="stat-label">规划师数</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon plan-icon">📋</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.pendingPlans || 0}}</text>
            <text class="stat-label">待审核计划</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon article-icon">📄</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.pendingArticles || 0}}</text>
            <text class="stat-label">待审核文章</text>
          </view>
        </view>
      </view>

      <view class="recent-activity">
        <text class="section-title">最近活动</text>
        <view class="activity-list">
          <view wx:for="{{recentActivities}}" wx:key="actKey" class="activity-item">
            <view class="activity-icon">{{item.icon}}</view>
            <view class="activity-content">
              <text class="activity-text">{{item.text}}</text>
              <text class="activity-time">{{item.time}}</text>
            </view>
          </view>
          <view wx:if="{{recentActivities.length === 0}}" class="empty-text">暂无活动记录</view>
        </view>
      </view>

      <view class="system-notices">
        <text class="section-title">系统通知</text>
        <view class="notice-list">
          <view wx:for="{{notices}}" wx:key="index" class="notice-item">
            <view class="notice-icon">📢</view>
            <view class="notice-content">
              <text class="notice-title">{{item.title}}</text>
              <text class="notice-text">{{item.content}}</text>
              <text class="notice-time">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 审核中心 -->
    <view wx:if="{{activeTab === 'audit'}}" class="content-panel">
      <view class="audit-tabs">
        <view class="audit-tab {{auditSubTab === 'plans' ? 'active' : ''}}" bindtap="switchAuditSubTab" data-subtab="plans">
          <text class="tab-icon">📋</text>
          <text>膳食计划</text>
          <text class="badge" wx:if="{{pendingPlansCount > 0}}">{{pendingPlansCount}}</text>
        </view>
        <view class="audit-tab {{auditSubTab === 'articles' ? 'active' : ''}}" bindtap="switchAuditSubTab" data-subtab="articles">
          <text class="tab-icon">📄</text>
          <text>健康文章</text>
          <text class="badge" wx:if="{{pendingArticlesCount > 0}}">{{pendingArticlesCount}}</text>
        </view>
        <view class="audit-tab {{auditSubTab === 'ingredients' ? 'active' : ''}}" bindtap="switchAuditSubTab" data-subtab="ingredients">
          <text class="tab-icon">🥗</text>
          <text>食材新增</text>
          <text class="badge" wx:if="{{pendingIngredientsCount > 0}}">{{pendingIngredientsCount}}</text>
        </view>
        <view class="audit-tab {{auditSubTab === 'history' ? 'active' : ''}}" bindtap="switchAuditSubTab" data-subtab="history">
          <text class="tab-icon">📊</text>
          <text>审核历史</text>
        </view>
      </view>

      <view class="audit-list">
        <view wx:if="{{auditSubTab === 'plans'}}">
          <view wx:if="{{planLoading}}" class="empty-state">
            <text class="empty-text">加载中...</text>
          </view>
          <view wx:for="{{pendingPlans}}" wx:key="index" class="audit-item">
            <view class="item-header">
              <text class="item-title">{{item.title}}</text>
              <text class="item-status">待审核</text>
            </view>
            <view class="item-body">
              <view class="item-info">
                <text class="info-label">用户：</text>
                <text class="info-value">{{item.user}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">规划师：</text>
                <text class="info-value">{{item.dietitian}}</text>
              </view>
              <view class="item-info item-info--singleline">
                <text class="info-label">提交时间：</text>
                <text class="info-value info-value--singleline">{{item.submitTime}}</text>
              </view>
            </view>
            <view class="item-footer">
              <view class="btn-primary" bindtap="approvePlan" data-id="{{item.id}}">通过</view>
              <view class="btn-secondary" bindtap="rejectPlan" data-id="{{item.id}}">驳回</view>
              <view class="btn-text" bindtap="viewPlanDetail" data-item="{{item}}">查看详情</view>
            </view>
          </view>
          <view wx:if="{{planHint}}" class="empty-state">
            <text class="empty-text">{{planHint}}</text>
          </view>
          <view wx:if="{{!planLoading && !planHint && pendingPlans.length === 0}}" class="empty-state">
            <text class="empty-icon">📋</text>
            <text class="empty-text">暂无待审核的膳食计划</text>
          </view>
        </view>

        <view wx:if="{{auditSubTab === 'articles'}}">
          <view class="article-audit-subtabs">
            <view class="article-audit-subtab {{articleAuditTab === 'pending' ? 'active' : ''}}" bindtap="switchArticleAuditTab" data-tab="pending">待审核</view>
            <view class="article-audit-subtab {{articleAuditTab === 'approved' ? 'active' : ''}}" bindtap="switchArticleAuditTab" data-tab="approved">已通过</view>
            <view class="article-audit-subtab {{articleAuditTab === 'rejected' ? 'active' : ''}}" bindtap="switchArticleAuditTab" data-tab="rejected">已驳回</view>
          </view>
          <view wx:for="{{pendingArticles}}" wx:key="index" class="audit-item">
            <view class="item-header">
              <text class="item-title">{{item.title}}</text>
              <text class="item-status">{{item.statusLabel || '待审核'}}</text>
            </view>
            <view class="item-body">
              <view class="item-info">
                <text class="info-label">规划师：</text>
                <text class="info-value">{{item.dietitian}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">分类：</text>
                <text class="info-value">{{item.category}}</text>
              </view>
              <view class="item-info item-info--singleline">
                <text class="info-label">提交时间：</text>
                <text class="info-value info-value--singleline">{{item.submitTime}}</text>
              </view>
              <view class="article-preview">
                <text class="preview-text">{{item.preview}}</text>
              </view>
            </view>
            <view class="item-footer">
              <view wx:if="{{articleAuditTab === 'pending'}}" class="btn-primary" bindtap="approveArticle" data-id="{{item.he_id}}">通过</view>
              <view wx:if="{{articleAuditTab === 'pending'}}" class="btn-secondary" bindtap="rejectArticle" data-id="{{item.he_id}}">驳回</view>
              <view class="btn-text" bindtap="viewArticleDetail" data-id="{{item.he_id}}">查看详情</view>
            </view>
          </view>
          <view wx:if="{{pendingArticles.length === 0}}" class="empty-state">
            <text class="empty-icon">📄</text>
            <text class="empty-text">暂无待审核的健康文章</text>
          </view>
        </view>

        <view wx:if="{{auditSubTab === 'ingredients'}}">
          <view wx:if="{{ingredientLoading}}" class="empty-state">
            <text class="empty-text">加载中...</text>
          </view>
          <view wx:for="{{ingredientSubmissions}}" wx:key="submission_id" class="audit-item">
            <view class="item-header">
              <text class="item-title">{{item.submitted_name}}</text>
              <text class="item-status risk-{{item.auto_check_result}}">{{item.riskText}}</text>
            </view>
            <view class="item-body">
              <view class="item-info">
                <text class="info-label">类别：</text>
                <text class="info-value">{{item.submitted_category}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">提交人：</text>
                <text class="info-value">{{item.user_id}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">热量：</text>
                <text class="info-value">{{item.submitted_calories_per_100g}} kcal/100g</text>
              </view>
              <view class="item-info item-info--singleline">
                <text class="info-label">风险/偏差：</text>
                <text class="info-value info-value--singleline">{{item.riskText}} · {{item.deltaPct}}</text>
              </view>
            </view>
            <view class="item-footer ingredient-actions">
              <view class="btn-text ingredient-detail-link" bindtap="viewIngredientSubmissionDetail" data-item="{{item}}">查看详情</view>
              <view class="ingredient-action-group">
                <view class="btn-primary ingredient-btn-approve" bindtap="approveIngredientSubmission" data-id="{{item.submission_id}}">通过</view>
                <view class="btn-primary ingredient-btn-edit" bindtap="openIngredientEditModal" data-item="{{item}}">修正并通过</view>
                <view class="btn-secondary ingredient-btn-return" bindtap="rejectIngredientSubmission" data-id="{{item.submission_id}}">退回</view>
              </view>
            </view>
          </view>
          <view wx:if="{{!ingredientLoading && ingredientSubmissions.length === 0}}" class="empty-state">
            <text class="empty-icon">🥗</text>
            <text class="empty-text">暂无待审核食材</text>
          </view>
        </view>

        <view wx:if="{{auditSubTab === 'history'}}">
          <view wx:if="{{historyLoading}}" class="empty-state">
            <text class="empty-text">加载中...</text>
          </view>
          <view wx:for="{{auditHistory}}" wx:key="index" class="audit-item">
            <view class="item-header">
              <text class="item-title">{{item.title}}</text>
              <text class="item-status {{item.status === '通过' ? 'status-approved' : 'status-rejected'}}">{{item.status}}</text>
            </view>
            <view class="item-body">
              <view class="item-info">
                <text class="info-label">类型：</text>
                <text class="info-value">{{item.type}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">审核人：</text>
                <text class="info-value">{{item.auditor}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">审核时间：</text>
                <text class="info-value">{{item.auditTime}}</text>
              </view>
              <view wx:if="{{item.reason}}" class="reject-reason">
                <text class="reason-label">驳回原因：</text>
                <text class="reason-text">{{item.reason}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{historyHint}}" class="empty-state">
            <text class="empty-text">{{historyHint}}</text>
          </view>
          <view wx:if="{{!historyLoading && !historyHint && auditHistory.length === 0}}" class="empty-state">
            <text class="empty-icon">📋</text>
            <text class="empty-text">暂无审核历史</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{showArticleDetailModal}}" class="modal-mask" bindtap="hideArticleDetailModal">
      <view class="modal-content" catchtap="stopPropagation">
        <view class="modal-header">
          <text class="modal-title">健康文章详情</text>
          <view class="modal-close" bindtap="hideArticleDetailModal">×</view>
        </view>
        <view class="modal-body" bindscroll="onArticleDetailScroll">
          <view wx:if="{{!articleDetailScrolled}}" class="article-detail-head">
            <view class="article-detail-title">{{selectedArticle.title || '—'}}</view>
            <view class="article-detail-author">
              <text class="article-detail-author-label">作者：</text>
              <text class="article-detail-author-value">{{selectedArticle.dietitian || '—'}}</text>
            </view>
          </view>
          <view wx:if="{{!articleDetailScrolled}}" class="article-detail-extra">
            <view class="article-detail-extra-toggle" bindtap="toggleArticleInfoExpand">
              <text class="article-detail-extra-title">文章信息</text>
              <text class="article-detail-extra-arrow">{{articleInfoExpanded ? '收起' : '展开'}}</text>
            </view>
            <view wx:if="{{articleInfoExpanded}}" class="article-detail-extra-body">
              <view class="item-info"><text class="info-label">状态：</text><text class="info-value">{{selectedArticle.statusLabel || '—'}}</text></view>
              <view class="item-info"><text class="info-label">分类：</text><text class="info-value">{{selectedArticle.category || '—'}}</text></view>
              <view class="item-info"><text class="info-label">范围：</text><text class="info-value">{{selectedArticle.visibilityLabel || '—'}}</text></view>
              <view class="item-info"><text class="info-label">时间：</text><text class="info-value">{{selectedArticle.submitTime || '—'}}</text></view>
              <view class="item-info"><text class="info-label">摘要：</text><text class="info-value">{{selectedArticle.summary || '—'}}</text></view>
            </view>
          </view>
          <view wx:if="{{selectedArticle.review_note && !articleDetailScrolled}}" class="article-detail-review-note">
            <text class="article-detail-review-note-label">驳回原因</text>
            <text class="article-detail-review-note-text">{{selectedArticle.review_note}}</text>
          </view>
          <view class="article-detail-body-block">
            <text class="article-detail-body-title">正文内容</text>
            <view class="article-detail-body-content">
              <text class="article-detail-body-text">{{selectedArticle.body || '—'}}</text>
            </view>
          </view>
        </view>
        <view class="modal-footer">
          <view class="btn-cancel" bindtap="hideArticleDetailModal">关闭</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showPlanDetailModal}}" class="modal-mask" bindtap="hidePlanDetailModal">
      <view class="modal-content" catchtap="stopPropagation">
        <view class="modal-header">
          <text class="modal-title">膳食计划详情</text>
          <view class="modal-close" bindtap="hidePlanDetailModal">×</view>
        </view>
        <scroll-view class="modal-body" scroll-y="true" bindscroll="onPlanDetailScroll">
          <view wx:if="{{!planDetailScrolled}}" class="plan-detail-head">
            <view class="plan-detail-title">{{selectedPlanDetail.title || '—'}}</view>
            <view class="plan-detail-owner">
              <text class="plan-detail-owner-label">用户：</text>
              <text class="plan-detail-owner-value">{{selectedPlanDetail.user_id || '—'}}</text>
              <text class="plan-detail-owner-split">·</text>
              <text class="plan-detail-owner-label">规划师：</text>
              <text class="plan-detail-owner-value">{{selectedPlanDetail.dietitian_name || selectedPlanDetail.dietitian_id || '—'}}</text>
            </view>
          </view>

          <view wx:if="{{!planDetailScrolled}}" class="plan-detail-extra">
            <view class="plan-detail-extra-toggle" bindtap="togglePlanInfoExpand">
              <text class="plan-detail-extra-title">计划信息</text>
              <text class="plan-detail-extra-arrow">{{planInfoExpanded ? '收起' : '展开'}}</text>
            </view>
            <view wx:if="{{planInfoExpanded}}" class="plan-detail-extra-body">
              <view class="item-info item-info--singleline"><text class="info-label">饮食目标：</text><text class="info-value info-value--singleline">{{selectedPlanDetail.goal_text || '—'}}</text></view>
              <view class="item-info item-info--singleline"><text class="info-label">执行周期：</text><text class="info-value info-value--singleline">{{selectedPlanDetail.cycle_days || 0}} 天</text></view>
              <view class="item-info item-info--singleline"><text class="info-label">提交时间：</text><text class="info-value info-value--singleline">{{selectedPlanDetail.update_time_text || '—'}}</text></view>
            </view>
          </view>

          <view wx:if="{{selectedPlanDetail.audit_note}}" class="plan-detail-review-note">
            <text class="plan-detail-review-note-label">驳回原因</text>
            <text class="plan-detail-review-note-text">{{selectedPlanDetail.audit_note}}</text>
          </view>

          <view class="plan-detail-body-block">
            <text class="plan-detail-body-title">每日膳食安排</text>
            <view class="plan-detail-body-content">
              <view class="plan-detail-date-selector">
                <text class="plan-detail-date-label">查看日期</text>
                <picker mode="date" value="{{planDetailSelectedDate}}" bindchange="onPlanDetailDateChange">
                  <view class="plan-detail-date-value-wrap">
                    <text class="plan-detail-date-value">{{planDetailSelectedDateText || '请选择日期'}}</text>
                    <text class="plan-detail-date-arrow">▾</text>
                  </view>
                </picker>
              </view>

              <view wx:if="{{planDetailCurrentDay}}" class="plan-day-card">
                <view class="plan-day-header">
                  <text class="plan-day-title">第{{planDetailCurrentDay.day_index}}天</text>
                  <text class="plan-day-meta">{{planDetailSelectedDateText}} · {{planDetailCurrentDay.calories}} kcal</text>
                </view>
                <view wx:for="{{planDetailCurrentDay.meals}}" wx:key="id" class="plan-meal-card">
                  <view class="plan-meal-head">
                    <text class="plan-meal-type">{{item.type}}</text>
                    <text class="plan-meal-meta">{{item.time}} · {{item.calories}} kcal</text>
                  </view>
                  <view class="plan-food-list">
                    <text wx:for="{{item.foods}}" wx:key="id" wx:for-item="food" class="plan-food-item">{{food.name}} {{food.amount}}（{{food.calories}}kcal）</text>
                  </view>
                </view>
              </view>
              <view wx:else class="empty-state">
                <text class="empty-text">暂无当日膳食明细</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <view class="modal-footer">
          <view class="btn-secondary" bindtap="hidePlanDetailModal">关闭</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showIngredientDetailModal}}" class="modal-mask" bindtap="hideIngredientDetailModal">
      <view class="modal-content" catchtap="stopPropagation">
        <view class="modal-header">
          <text class="modal-title">食材提交详情</text>
          <view class="modal-close" bindtap="hideIngredientDetailModal">×</view>
        </view>
        <view class="modal-body">
          <view class="item-info"><text class="info-label">食材：</text><text class="info-value">{{selectedIngredientSubmission.submitted_name}}</text></view>
          <view class="item-info"><text class="info-label">类别：</text><text class="info-value">{{selectedIngredientSubmission.submitted_category}}</text></view>
          <view class="item-info"><text class="info-label">提交人：</text><text class="info-value">{{selectedIngredientSubmission.user_id}}</text></view>
          <view class="item-info"><text class="info-label">热量：</text><text class="info-value">{{selectedIngredientSubmission.submitted_calories_per_100g}} kcal/100g</text></view>
          <view class="item-info"><text class="info-label">蛋白质：</text><text class="info-value">{{selectedIngredientSubmission.submitted_nutrition_100g.protein}} g/100g</text></view>
          <view class="item-info"><text class="info-label">碳水：</text><text class="info-value">{{selectedIngredientSubmission.submitted_nutrition_100g.carbohydrate}} g/100g</text></view>
          <view class="item-info"><text class="info-label">脂肪：</text><text class="info-value">{{selectedIngredientSubmission.submitted_nutrition_100g.fat}} g/100g</text></view>
          <view class="item-info"><text class="info-label">单位：</text><text class="info-value">{{selectedIngredientSubmission.submitted_unit}}，每单位{{selectedIngredientSubmission.submitted_gram_per_unit}}g</text></view>
          <view class="item-info"><text class="info-label">估算热量：</text><text class="info-value">{{selectedIngredientSubmission.auto_calc_calories}} kcal/100g</text></view>
          <view class="item-info"><text class="info-label">风险/偏差：</text><text class="info-value">{{selectedIngredientSubmission.riskText}} · {{selectedIngredientSubmission.deltaPct}}</text></view>
          <view class="item-info"><text class="info-label">提交时间：</text><text class="info-value">{{selectedIngredientSubmission.submitTimeText}}</text></view>
        </view>
        <view class="modal-footer">
          <view class="btn-cancel" bindtap="hideIngredientDetailModal">关闭</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showIngredientEditModal}}" class="modal-mask" bindtap="hideIngredientEditModal">
      <view class="modal-content" catchtap="stopPropagation">
        <view class="modal-header">
          <text class="modal-title">修正并通过</text>
          <view class="modal-close" bindtap="hideIngredientEditModal">×</view>
        </view>
        <view class="modal-body">
          <view class="form-item"><text class="form-label">名称</text><input class="form-input" value="{{editIngredientForm.name}}" data-field="name" bindinput="bindEditIngredientField" /></view>
          <view class="form-item">
            <text class="form-label">类别</text>
            <picker mode="selector" range="{{ingredientCategoryOptions}}" value="{{ingredientCategoryIndex}}" bindchange="onIngredientEditCategoryChange">
              <view class="form-input">{{editIngredientForm.category || '请选择食材类别'}}</view>
            </picker>
          </view>
          <view class="form-item"><text class="form-label">热量(kcal/100g)</text><input class="form-input" type="digit" value="{{editIngredientForm.calorie_100g}}" data-field="calorie_100g" bindinput="bindEditIngredientField" /></view>
          <view class="form-item"><text class="form-label">蛋白质(g/100g)</text><input class="form-input" type="digit" value="{{editIngredientForm.protein}}" data-field="protein" bindinput="bindEditIngredientField" /></view>
          <view class="form-item"><text class="form-label">碳水(g/100g)</text><input class="form-input" type="digit" value="{{editIngredientForm.carbohydrate}}" data-field="carbohydrate" bindinput="bindEditIngredientField" /></view>
          <view class="form-item"><text class="form-label">脂肪(g/100g)</text><input class="form-input" type="digit" value="{{editIngredientForm.fat}}" data-field="fat" bindinput="bindEditIngredientField" /></view>
          <view class="form-item"><text class="form-label">单位</text><input class="form-input" value="{{editIngredientForm.unit}}" data-field="unit" bindinput="bindEditIngredientField" /></view>
          <view class="form-item"><text class="form-label">每单位克重(g)</text><input class="form-input" type="digit" value="{{editIngredientForm.gram_per_unit}}" data-field="gram_per_unit" bindinput="bindEditIngredientField" /></view>
          <view class="form-item"><text class="form-label">审核备注</text><input class="form-input" value="{{editIngredientForm.review_note}}" data-field="review_note" bindinput="bindEditIngredientField" /></view>
        </view>
        <view class="modal-footer">
          <view class="btn-cancel" bindtap="hideIngredientEditModal">取消</view>
          <view class="btn-confirm" bindtap="submitIngredientApproveWithEdit">提交</view>
        </view>
      </view>
    </view>

    <!-- 管理中心 -->
    <view wx:if="{{activeTab === 'manage'}}" class="content-panel">
      <view class="manage-tabs-container">
        <view class="manage-tabs" bindscroll="onTabsScroll">
          <view class="manage-tab {{manageSubTab === 'users' ? 'active' : ''}}" bindtap="switchManageSubTab" data-subtab="users">
            <text class="tab-icon">👥</text>
            <text>用户管理</text>
          </view>
          <view class="manage-tab {{manageSubTab === 'dietitians' ? 'active' : ''}}" bindtap="switchManageSubTab" data-subtab="dietitians">
            <text class="tab-icon">👨‍⚕️</text>
            <text>规划师管理</text>
          </view>
          <view class="manage-tab {{manageSubTab === 'nutrition' ? 'active' : ''}}" bindtap="switchManageSubTab" data-subtab="nutrition">
            <text class="tab-icon">🍎</text>
            <text>营养库管理</text>
          </view>
          <view class="manage-tab {{manageSubTab === 'feedback' ? 'active' : ''}}" bindtap="switchManageSubTab" data-subtab="feedback">
            <text class="tab-icon">💬</text>
            <text>反馈管理</text>
          </view>
          <view class="manage-tab {{manageSubTab === 'settings' ? 'active' : ''}}" bindtap="switchManageSubTab" data-subtab="settings">
            <text class="tab-icon">⚙️</text>
            <text>设置</text>
          </view>
        </view>
        <view class="scroll-indicator" wx:if="{{hasMoreTabs}}">
          <text class="indicator-icon">→</text>
        </view>
      </view>
      
      <!-- 首次访问提示 -->
      <view wx:if="{{showTabHint}}" class="tab-hint" bindtap="hideTabHint">
        <text class="hint-icon">💡</text>
        <text class="hint-text">向右滑动查看更多功能</text>
        <text class="hint-close">×</text>
      </view>

      <view class="manage-list">
        <view wx:if="{{manageSubTab === 'users'}}">
          <view wx:for="{{users}}" wx:key="user_id" class="manage-item">
            <view class="item-header">
              <view class="user-avatar-small">{{item.usernameInitial}}</view>
              <view class="user-info-small">
                <text class="item-title">{{item.username}}</text>
                <text class="item-subtitle">{{item.role}}</text>
              </view>
              <text class="item-status {{item.status === '正常' ? 'status-active' : 'status-inactive'}}">{{item.status}}</text>
            </view>
            <view class="item-footer">
              <view class="btn-text" bindtap="editUser" data-index="{{index}}">编辑</view>
              <view
                class="btn-text"
                wx:if="{{item.canToggle}}"
                bindtap="toggleUserStatus"
                data-index="{{index}}"
              >{{item.status === '正常' ? '禁用' : '启用'}}</view>
            </view>
          </view>
          <view wx:if="{{users.length === 0}}" class="empty-state">
            <text class="empty-icon">👥</text>
            <text class="empty-text">暂无用户数据</text>
          </view>
        </view>

        <view wx:if="{{manageSubTab === 'dietitians'}}">
          <view class="add-dietitian-btn" bindtap="showAddDietitianForm">
            <text class="add-icon">+</text>
            <text class="add-text">添加规划师</text>
          </view>
          <view wx:for="{{dietitians}}" wx:key="index" class="manage-item">
            <view class="item-header">
              <view class="dietitian-avatar">{{item.nameInitial}}</view>
              <view class="user-info-small">
                <text class="item-title">{{item.displayName}}</text>
                <text class="item-subtitle">{{item.title}} · {{item.specialty}}</text>
              </view>
              <text class="item-status {{item.status === '启用' ? 'status-active' : 'status-inactive'}}">{{item.status}}</text>
            </view>
            <view class="item-body">
              <view class="item-info">
                <text class="info-label">工号：</text>
                <text class="info-value">{{item.username}}</text>
              </view>
              <view class="item-info">
                <text class="info-label">联系方式：</text>
                <text class="info-value">{{item.contact}}</text>
              </view>
            </view>
            <view class="item-footer">
              <view class="btn-text" bindtap="toggleDietitianStatus" data-index="{{index}}">{{item.status === '启用' ? '禁用' : '启用'}}</view>
              <view class="btn-text btn-danger" bindtap="deleteDietitian" data-index="{{index}}">删除</view>
            </view>
          </view>
          <view wx:if="{{dietitians.length === 0}}" class="empty-state">
            <text class="empty-icon">👨‍⚕️</text>
            <text class="empty-text">暂无规划师</text>
          </view>
        </view>

        <view wx:if="{{manageSubTab === 'nutrition'}}">
          <view class="add-nutrition-btn" bindtap="showAddNutritionForm">
            <text class="add-icon">+</text>
            <text class="add-text">添加食物营养数据</text>
          </view>
          
          <!-- 类别筛选 -->
          <view class="category-filter">
            <scroll-view scroll-x="true" class="category-scroll">
              <view wx:for="{{categories}}" wx:key="index" 
                class="category-item {{selectedCategory === item ? 'active' : ''}}" 
                bindtap="selectCategory" data-category="{{item}}">
                <text>{{item}}</text>
              </view>
            </scroll-view>
          </view>
          
          <view wx:for="{{nutritionItems}}" wx:key="index" class="manage-item">
            <view class="item-header">
              <text class="item-title">{{item.name}}</text>
              <text class="item-category">{{item.category || '其他'}}</text>
            </view>
            <view class="item-body">
              <view class="nutrition-info">
                <view class="nutrition-item">
                  <text class="info-label">热量：</text>
                  <text class="info-value">{{item.calories}} kcal/{{item.unit || 'g'}}</text>
                </view>
                <view class="nutrition-item">
                  <text class="info-label">蛋白质：</text>
                  <text class="info-value">{{item.protein}} g</text>
                </view>
                <view class="nutrition-item">
                  <text class="info-label">碳水：</text>
                  <text class="info-value">{{item.carbohydrate}} g</text>
                </view>
                <view class="nutrition-item">
                  <text class="info-label">脂肪：</text>
                  <text class="info-value">{{item.fat}} g</text>
                </view>
                <view class="nutrition-item">
                  <text class="info-label">单位：</text>
                  <text class="info-value">{{item.unit || 'g'}} ({{item.gramPerUnit || 100}}g)</text>
                </view>
              </view>
            </view>
            <view class="item-footer">
              <view class="btn-text" bindtap="editNutritionItem" data-index="{{index}}">编辑</view>
              <view class="btn-text btn-danger" bindtap="deleteNutritionItem" data-index="{{index}}">删除</view>
            </view>
          </view>
          
          <!-- 分页控件 -->
          <view wx:if="{{nutritionItems.length > 0}}" class="pagination">
            <view class="pagination-info">
              <text>共 {{total}} 条数据</text>
              <text>第 {{currentPage}} / {{totalPages}} 页</text>
            </view>
            <view class="pagination-controls">
              <view class="btn-page {{currentPage === 1 ? 'disabled' : ''}}" bindtap="prevPage">上一页</view>
              <view class="page-size-selector">
                <picker bindchange="changePageSize" range="{{pageSizeOptions}}" value="{{pageSizeIndex}}">
                  <view class="picker-view">
                    每页 {{pageSize}} 条
                  </view>
                </picker>
              </view>
              <view class="btn-page {{currentPage >= totalPages ? 'disabled' : ''}}" bindtap="nextPage">下一页</view>
            </view>
          </view>
          
          <view wx:if="{{nutritionItems.length === 0}}" class="empty-state">
            <text class="empty-icon">🍎</text>
            <text class="empty-text">暂无营养数据</text>
          </view>
        </view>

        <view wx:if="{{manageSubTab === 'feedback'}}">
          <view wx:for="{{feedbacks}}" wx:key="index" class="manage-item">
            <view class="item-header">
              <text class="item-title">{{item.title}}</text>
              <text class="item-status {{item.status === '已处理' ? 'status-approved' : ''}}">{{item.status}}</text>
            </view>
            <view class="item-body">
              <text class="item-desc">{{item.content}}</text>
              <text class="item-time">{{item.time}}</text>
            </view>
            <view class="item-footer">
              <view class="btn-primary" bindtap="replyFeedback" data-index="{{index}}">回复</view>
              <view class="btn-secondary" bindtap="markFeedback" data-index="{{index}}">标记已处理</view>
            </view>
          </view>
          <view wx:if="{{feedbacks.length === 0}}" class="empty-state">
            <text class="empty-icon">💬</text>
            <text class="empty-text">暂无反馈数据</text>
          </view>
        </view>

        <view wx:if="{{manageSubTab === 'settings'}}">
          <view class="settings-list">
            <view class="settings-item" bindtap="navigateToSettings">
              <text class="settings-icon">🔔</text>
              <text class="settings-text">消息通知设置</text>
              <text class="settings-arrow">></text>
            </view>
            <view class="settings-item" bindtap="navigateToSettings">
              <text class="settings-icon">🔒</text>
              <text class="settings-text">修改密码</text>
              <text class="settings-arrow">></text>
            </view>
            <view class="settings-item" bindtap="navigateToSettings">
              <text class="settings-icon">🛡️</text>
              <text class="settings-text">安全设置</text>
              <text class="settings-arrow">></text>
            </view>
            <view class="settings-item" bindtap="navigateToSettings">
              <text class="settings-icon">ℹ️</text>
              <text class="settings-text">系统信息</text>
              <text class="settings-arrow">></text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 统计中心 -->
    <view wx:if="{{activeTab === 'statistics'}}" class="content-panel">
      <view class="stats-overview">
        <view class="stat-card">
          <view class="stat-icon user-icon">📈</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.todayUsers || 0}}</text>
            <text class="stat-label">今日新增用户</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon dietitian-icon">📉</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.activeUsers || 0}}</text>
            <text class="stat-label">活跃用户</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon plan-icon">✅</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.completedPlans || 0}}</text>
            <text class="stat-label">已完成计划</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon article-icon">📚</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.healthEducationCount || 0}}</text>
            <text class="stat-label">健康教育文章</text>
          </view>
        </view>
      </view>

      <view class="chart-section">
        <text class="section-title">用户增长趋势</text>
        <view class="chart-placeholder">
          <view class="mini-bars" wx:if="{{userGrowthTrend.length > 0}}">
            <view class="mini-bar-item" wx:for="{{userGrowthTrend}}" wx:key="dateKey">
              <view class="mini-bar-track">
                <view class="mini-bar-fill" style="height: {{item.value > 0 ? (item.value * 10 + 12) : 8}}rpx;"></view>
              </view>
              <text class="mini-bar-value">{{item.value}}</text>
              <text class="mini-bar-label">{{item.label}}</text>
            </view>
          </view>
          <text class="chart-text" wx:else>暂无用户增长数据</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加规划师弹窗 -->
  <view wx:if="{{showAddDietitianModal}}" class="modal-mask" bindtap="hideAddDietitianForm">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">添加规划师</text>
        <view class="modal-close" bindtap="hideAddDietitianForm">×</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">用户名</text>
          <input class="form-input" placeholder="用于登录的账号" bindinput="bindDietitianUsername" value="{{newDietitian.username}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">真实姓名</text>
          <input class="form-input" placeholder="规划师真实姓名" bindinput="bindDietitianName" value="{{newDietitian.name}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">职称</text>
          <input class="form-input" placeholder="如：高级营养师" bindinput="bindDietitianTitle" value="{{newDietitian.title}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">专业领域</text>
          <input class="form-input" placeholder="如：临床营养" bindinput="bindDietitianSpecialty" value="{{newDietitian.specialty}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">个人简介</text>
          <textarea class="form-input form-textarea" maxlength="500" placeholder="请输入规划师简介（选填）" bindinput="bindDietitianIntroduction" value="{{newDietitian.introduction}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">联系方式</text>
          <input class="form-input" placeholder="手机号或邮箱" bindinput="bindDietitianContact" value="{{newDietitian.contact}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">登录密码</text>
          <input class="form-input" type="text" password placeholder="请输入初始密码" bindinput="bindDietitianPassword" value="{{newDietitian.password}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">状态</text>
          <picker bindchange="bindDietitianStatusChange" range="{{statusOptions}}" value="{{statusIndex}}">
            <view class="picker-view">
              {{statusOptions[statusIndex] || '请选择状态'}}
            </view>
          </picker>
        </view>
        <view class="form-message">
          <text wx:if="{{formError}}" class="error-text">{{formError}}</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="hideAddDietitianForm">取消</view>
        <view class="btn-confirm" bindtap="confirmAddDietitian">确认添加</view>
      </view>
    </view>
  </view>

  <!-- 营养库管理弹窗 -->
  <view wx:if="{{showAddNutritionModal}}" class="modal-mask" bindtap="hideAddNutritionForm">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editingNutritionIndex >= 0 ? '编辑食物营养数据' : '添加食物营养数据'}}</text>
        <view class="modal-close" bindtap="hideAddNutritionForm">×</view>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">食物名称</text>
          <input class="form-input" placeholder="请输入食物名称" bindinput="bindNutritionName" value="{{newNutrition.name}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">食材类别</text>
          <input class="form-input" placeholder="请输入食材类别（如：主食、蛋白质、水果、蔬菜等）" bindinput="bindNutritionCategory" value="{{newNutrition.category}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">蛋白质 (g/100g)</text>
          <input class="form-input" type="number" placeholder="请输入蛋白质" bindinput="bindNutritionProtein" value="{{newNutrition.protein}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">碳水化合物 (g/100g)</text>
          <input class="form-input" type="number" placeholder="请输入碳水化合物" bindinput="bindNutritionCarbohydrate" value="{{newNutrition.carbohydrate}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">脂肪 (g/100g)</text>
          <input class="form-input" type="number" placeholder="请输入脂肪" bindinput="bindNutritionFat" value="{{newNutrition.fat}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">计量单位</text>
          <input class="form-input" placeholder="请输入计量单位（如：g、ml、个、碗等）" bindinput="bindNutritionUnit" value="{{newNutrition.unit}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">1个/1碗等于多少克</text>
          <input class="form-input" type="number" placeholder="选填，默认为100" bindinput="bindNutritionGramPerUnit" value="{{newNutrition.gramPerUnit}}"/>
        </view>
        <view class="form-item">
          <text class="form-label">热量 (kcal/100g)</text>
          <input class="form-input" type="number" placeholder="自动计算" value="{{newNutrition.calories}}" disabled/>
          <text class="form-hint">热量根据蛋白质、碳水化合物和脂肪自动计算</text>
        </view>
        <view class="form-message">
          <text wx:if="{{formError}}" class="error-text">{{formError}}</text>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="hideAddNutritionForm">取消</view>
        <view class="btn-confirm" bindtap="confirmAddNutrition">{{editingNutritionIndex >= 0 ? '确认修改' : '确认添加'}}</view>
      </view>
    </view>
  </view>

  <!-- 个人中心弹窗（与全站主色/卡片风格统一） -->
  <view wx:if="{{showPersonalCenterModal}}" class="modal-mask" bindtap="hidePersonalCenter">
    <view class="personal-center-modal" catchtap="stopPropagation">
      <view class="pc-head">
        <view class="pc-head-left">
          <text class="pc-eyebrow">ACCOUNT</text>
          <text class="pc-title">个人中心</text>
        </view>
        <view class="pc-close" bindtap="hidePersonalCenter" hover-class="pc-close-press">×</view>
      </view>
      <view class="pc-body">
        <view class="pc-profile">
          <view class="pc-avatar" bindtap="chooseAvatar">管</view>
          <text class="pc-name">管理员</text>
          <text class="pc-role">系统管理员</text>
        </view>
        <view class="pc-list">
          <view class="pc-item" bindtap="changePassword" hover-class="pc-item-press">
            <view class="pc-item-main">
              <view class="pc-ico">密</view>
              <text class="pc-label">修改密码</text>
            </view>
            <text class="pc-chev">›</text>
          </view>
          <view class="pc-item pc-item--danger" bindtap="handleLogout" hover-class="pc-item-press">
            <view class="pc-item-main">
              <view class="pc-ico pc-ico--out">出</view>
              <text class="pc-label">退出登录</text>
            </view>
            <text class="pc-chev">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>