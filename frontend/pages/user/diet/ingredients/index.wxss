.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6f3ed 0%, #efeae0 100%);
  padding: 22rpx;
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 0 40rpx;
  text-align: center;
}

.avatar-placeholder {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f08b41 0%, #d66f2b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(76, 175, 80, 0.3);
}

.avatar-text {
  font-size: 44rpx;
  font-weight: 700;
  color: white;
}

.login-text {
  font-size: 28rpx;
  color: #6c675e;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.login-btn {
  width: 78%;
  height: 84rpx;
  background: #f08b41;
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(240, 139, 65, 0.3);
}

.header-card {
  background: #fbfaf8;
  border: 1rpx solid #e7dfd4;
  border-radius: 12rpx;
  box-shadow: 0 10rpx 24rpx rgba(30, 24, 16, 0.07);
  padding: 20rpx;
  margin-bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2f2a23;
}

.header-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #72685d;
}

.add-btn {
  background: #f08b41;
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}

.tab-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tab-item {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #6f665b;
  background: #f7f1e8;
  border: 1rpx solid #e6ddcf;
}

.tab-item.active {
  color: #ffffff;
  background: #2d6a4f;
  border-color: #2d6a4f;
}

.list-wrap {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-card {
  background: #fcfbf9;
  border: 1rpx solid #e6ddd0;
  border-radius: 12rpx;
  box-shadow: 0 6rpx 18rpx rgba(28, 22, 14, 0.06);
  padding: 18rpx;
}

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f2921;
}

.status-pill {
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
  font-size: 20rpx;
}

.status-pending {
  background: rgba(45, 106, 79, 0.15);
  color: #2d6a4f;
}

.status-returned {
  background: rgba(181, 109, 66, 0.2);
  color: #8d4d27;
}

.status-approved {
  background: rgba(43, 108, 176, 0.16);
  color: #2b6cb0;
}

.item-line {
  display: flex;
  margin-top: 6rpx;
  gap: 12rpx;
}

.label {
  width: 84rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #7a7063;
}

.value {
  font-size: 22rpx;
  color: #352f27;
  flex: 1;
}

.returned-note {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  background: #fff3df;
  color: #8d4d27;
  font-size: 22rpx;
}

.item-foot {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.detail-btn {
  font-size: 22rpx;
  color: #2d6a4f;
  padding: 8rpx 14rpx;
}

.empty-wrap {
  background: #fbfaf8;
  border: 1rpx dashed #d7cec0;
  border-radius: 12rpx;
  padding: 44rpx 20rpx;
  text-align: center;
}

.empty-text {
  color: #746a5f;
  font-size: 24rpx;
}

.detail-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(16, 24, 40, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 24rpx;
}

.detail-modal-card {
  width: 100%;
  max-height: 82vh;
  background: #fbfaf8;
  border-radius: 14rpx;
  border: 1rpx solid #e6ddd0;
  box-shadow: 0 18rpx 36rpx rgba(20, 15, 10, 0.18);
  display: flex;
  flex-direction: column;
}

.detail-modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #eee4d6;
}

.detail-modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #26221d;
}

.detail-modal-close {
  font-size: 40rpx;
  color: #8b8175;
  line-height: 1;
  padding: 4rpx 10rpx;
}

.detail-modal-body {
  padding: 16rpx 24rpx 8rpx;
  overflow-y: auto;
}