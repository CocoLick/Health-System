<view class="container">
  <view wx:if="{{!isLoggedIn}}" class="login-container">
    <view class="avatar-placeholder"><text class="avatar-text">登录</text></view>
    <text class="login-text">登录后可查看并管理你新增的私有食材</text>
    <button class="login-btn" bindtap="handleLogin">立即登录</button>
  </view>

  <view wx:else>
    <view class="header-card">
      <view>
        <view class="header-title">我的食材管理</view>
        <view class="header-sub">查看新增食材审核状态；通过后纳入食材库，退回可修改重提</view>
      </view>
      <view class="add-btn" bindtap="goSubmitNew">+ 新增</view>
    </view>

    <view class="tab-row">
      <view wx:for="{{tabs}}" wx:key="id" class="tab-item {{statusTab===item.id?'active':''}}" data-tab="{{item.id}}" bindtap="switchTab">{{item.text}}</view>
    </view>

    <view wx:if="{{loading}}" class="empty-wrap"><text class="empty-text">加载中...</text></view>

    <view wx:else class="list-wrap">
      <view wx:for="{{visibleItems}}" wx:key="submission_id" class="item-card">
        <view class="item-head">
          <text class="item-title">{{item.submitted_name}}</text>
          <text class="status-pill {{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <view class="item-line"><text class="label">类别</text><text class="value">{{item.submitted_category}}</text></view>
        <view class="item-line"><text class="label">热量</text><text class="value">{{item.submitted_calories_per_100g}} kcal/100g</text></view>
        <view class="item-line"><text class="label">营养</text><text class="value">{{item.nutritionText}} (g/100g)</text></view>
        <view class="item-line"><text class="label">更新</text><text class="value">{{item.updatedText}}</text></view>
        <view wx:if="{{item.workflow_status==='returned' && item.review_note}}" class="returned-note">
          退回原因：{{item.review_note}}
        </view>
        <view class="item-foot">
          <view wx:if="{{item.workflow_status==='returned'}}" class="detail-btn" bindtap="editReturnedItem" data-item="{{item}}">重新编辑</view>
          <view class="detail-btn" bindtap="showDetail" data-item="{{item}}">查看详情</view>
        </view>
      </view>
      <view wx:if="{{visibleItems.length===0}}" class="empty-wrap">
        <text class="empty-text">暂无对应食材记录</text>
      </view>
    </view>

    <view wx:if="{{showDetailModal}}" class="detail-modal-mask" bindtap="hideDetailModal">
      <view class="detail-modal-card" catchtap="noop">
        <view class="detail-modal-head">
          <text class="detail-modal-title">食材详情</text>
          <view class="detail-modal-close" bindtap="hideDetailModal">×</view>
        </view>
        <view class="detail-modal-body">
          <view class="item-line"><text class="label">名称</text><text class="value">{{selectedItem.submitted_name}}</text></view>
          <view class="item-line"><text class="label">类别</text><text class="value">{{selectedItem.submitted_category}}</text></view>
          <view class="item-line"><text class="label">状态</text><text class="value">{{selectedItem.statusText}}</text></view>
          <view class="item-line"><text class="label">热量</text><text class="value">{{selectedItem.submitted_calories_per_100g}} kcal/100g</text></view>
          <view class="item-line"><text class="label">蛋白质</text><text class="value">{{selectedItem.submitted_nutrition_100g.protein}} g/100g</text></view>
          <view class="item-line"><text class="label">碳水</text><text class="value">{{selectedItem.submitted_nutrition_100g.carbohydrate}} g/100g</text></view>
          <view class="item-line"><text class="label">脂肪</text><text class="value">{{selectedItem.submitted_nutrition_100g.fat}} g/100g</text></view>
          <view class="item-line"><text class="label">单位</text><text class="value">{{selectedItem.submitted_unit}}，每单位{{selectedItem.submitted_gram_per_unit}}g</text></view>
          <view class="item-line"><text class="label">更新时间</text><text class="value">{{selectedItem.updatedText}}</text></view>
          <view wx:if="{{selectedItem.review_note}}" class="returned-note">
            退回原因：{{selectedItem.review_note}}
          </view>
        </view>
        <view class="item-foot">
          <view class="detail-btn" bindtap="hideDetailModal">关闭</view>
        </view>
      </view>
    </view>
  </view>
</view>