.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f2ec 0%, #f1ede6 100%);
  padding: 24rpx;
}

.card {
  background: #fbfaf8;
  border: 1rpx solid #e5ded2;
  border-radius: 10rpx;
  box-shadow: 0 10rpx 30rpx rgba(36, 31, 25, 0.06);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b2b2b;
}

.sub {
  margin-top: 8rpx;
  color: #6e675d;
  font-size: 24rpx;
}

.return-reason {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: #fff3df;
  color: #8d4d27;
  font-size: 22rpx;
}

.form-item {
  margin-top: 18rpx;
}

.label {
  color: #4b4740;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.input {
  height: 74rpx;
  border-radius: 8rpx;
  border: 1rpx solid #ddd5c8;
  background: #fffdf9;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.picker-like {
  display: flex;
  align-items: center;
  color: #2e2a24;
}

.grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 4rpx;
}

.tip-card {
  border-left: 6rpx solid #f0a23e;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f2a22;
  margin-bottom: 10rpx;
}

.tip-line {
  font-size: 24rpx;
  color: #575249;
  line-height: 1.8;
}

.warn {
  color: #c1502b;
}

.submit {
  margin-top: 16rpx;
  background: #f08b41;
  color: #fff;
  border-radius: 10rpx;
}
