<view class="container page-surface-bg">
  <view wx:if="{{!isLoggedIn}}">
    <view class="auth-guard">
      <view class="auth-title">请先登录</view>
      <view class="auth-login-btn" bindtap="gotoLogin">去登录</view>
    </view>
  </view>

  <block wx:else>
    <view class="health-page-head">
      <text class="health-page-title">健康中心</text>
      <text class="health-page-subtitle">管理健康数据，查看营养评估与健康教育</text>
    </view>

    <view class="health-main-tabs health-main-tabs-3">
      <view
        class="h-main-tab {{healthMainTab === 'data' ? 'active' : ''}}"
        bindtap="switchHealthMainTab"
        data-tab="data"
      >健康数据</view>
      <view
        class="h-main-tab {{healthMainTab === 'evaluation' ? 'active' : ''}}"
        bindtap="switchHealthMainTab"
        data-tab="evaluation"
      >营养评估</view>
      <view
        class="h-main-tab {{healthMainTab === 'education' ? 'active' : ''}}"
        bindtap="switchHealthMainTab"
        data-tab="education"
      >健康教育</view>
    </view>

    <view wx:if="{{healthMainTab === 'data'}}" class="health-data-panel">
      <view class="section">
        <view class="section-header">
          <view class="section-title">基本信息</view>
          <view class="section-action" bindtap="editBasicInfo">编辑</view>
        </view>
        <view class="info-grid info-grid-card">
          <view class="info-row">
            <view class="info-item info-item-card">
              <view class="info-label">性别</view>
              <view class="info-value">{{healthData.gender || '未设置'}}</view>
            </view>
            <view class="info-item info-item-card">
              <view class="info-label">年龄</view>
              <view class="info-value">{{healthData.age || '未设置'}}岁</view>
            </view>
          </view>
          <view class="info-row">
            <view class="info-item info-item-card">
              <view class="info-label">活动水平</view>
              <view class="info-value">{{!healthData.activityLevel ? '未设置' : (healthData.activityLevel === 'sedentary' ? '久坐' : healthData.activityLevel === 'lightly_active' ? '轻度' : healthData.activityLevel === 'moderately_active' ? '中度' : healthData.activityLevel === 'very_active' ? '高强度' : '未设置')}}</view>
            </view>
            <view class="info-item info-item-card">
              <view class="info-label">营养目标</view>
              <view class="info-value">{{!healthData.nutritionGoal ? '未设置' : (healthData.nutritionGoal === 'lose_weight' ? '减重' : healthData.nutritionGoal === 'maintain' ? '维持' : healthData.nutritionGoal === 'healthy_gain' ? '健康增重' : '未设置')}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <view class="section-title">健康指标</view>
          <view class="section-action" bindtap="editHealthMetrics">编辑</view>
        </view>
        <view class="health-card health-metrics-grid">
          <view class="health-item">
            <view class="health-icon">身高</view>
            <view class="health-info">
              <view class="health-value">{{healthData.height || '--'}} <text class="unit">cm</text></view>
            </view>
          </view>
          <view class="health-item">
            <view class="health-icon">体重</view>
            <view class="health-info">
              <view class="health-value">{{healthData.weight || '--'}} <text class="unit">kg</text></view>
            </view>
          </view>
          <view class="health-item">
            <view class="health-icon">心率</view>
            <view class="health-info">
              <view class="health-value">{{healthData.heartRate || '--'}} <text class="unit">次/分</text></view>
            </view>
          </view>
          <view class="health-item">
            <view class="health-icon">血压</view>
            <view class="health-info">
              <view class="health-value">{{healthData.bloodPressure || '--'}} <text class="unit">mmHg</text></view>
            </view>
          </view>
          <view class="health-item">
            <view class="health-icon">血糖</view>
            <view class="health-info">
              <view class="health-value">{{healthData.bloodSugar || '--'}} <text class="unit">mmol/L</text></view>
            </view>
          </view>
          <view class="health-item allergy-item">
            <view class="health-icon">过敏病史</view>
            <view class="health-info">
              <view class="health-value allergy-value">{{healthData.allergyHistory || '无'}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-header">
          <view class="section-title">历史记录</view>
        </view>
        <view wx:if="{{historyRawList.length > 0}}">
          <view class="history-overview-grid">
            <view class="history-overview-item">
              <text class="history-overview-label">体重变化</text>
              <text class="history-overview-value">{{historyStats.weightDeltaText}}</text>
            </view>
            <view class="history-overview-item">
              <text class="history-overview-label">血糖变化</text>
              <text class="history-overview-value">{{historyStats.bloodSugarDeltaText}}</text>
            </view>
            <view class="history-overview-item">
              <text class="history-overview-label">心率变化</text>
              <text class="history-overview-value">{{historyStats.heartRateDeltaText}}</text>
            </view>
            <view class="history-overview-item">
              <text class="history-overview-label">样本数量</text>
              <text class="history-overview-value">{{historyStats.recordCountText}}</text>
            </view>
          </view>

          <view class="history-metric-tabs">
            <view
              wx:for="{{historyMetricTabs}}"
              wx:key="key"
              class="history-metric-tab {{selectedHistoryMetric === item.key ? 'active' : ''}}"
              data-metric="{{item.key}}"
              bindtap="switchHistoryMetric"
            >
              {{item.label}}
            </view>
          </view>

          <view class="history-day-tabs">
            <view
              wx:for="{{historyDayRanges}}"
              wx:key="*this"
              class="history-day-tab {{selectedHistoryDays === item ? 'active' : ''}}"
              data-days="{{item}}"
              bindtap="switchHistoryDayRange"
            >
              {{item}}天
            </view>
          </view>

          <view class="history-trend-card">
            <view class="history-trend-head">
              <view class="history-trend-main">{{historyMetricLatestText}}</view>
              <view class="history-trend-delta">{{historyMetricDeltaText}}</view>
            </view>
            <view class="history-trend-hint">{{historyTrendHint}}</view>
            <view class="history-trend-unit" wx:if="{{historyMetricUnit}}">单位：{{historyMetricUnit}}</view>
            <view class="history-trend-rule">统计口径：按天展示，每天取最后一条记录</view>
            <scroll-view class="history-bars-scroll" scroll-x="true" enhanced="true" show-scrollbar="false" wx:if="{{historyChartPoints.length > 0}}">
              <view class="history-line-row">
              <view class="history-y-axis">
                <view class="history-y-tick" wx:for="{{historyAxisTicks}}" wx:key="id" style="top: {{item.yPos}};">
                  <text class="history-y-text">{{item.text}}</text>
                  <view class="history-y-grid"></view>
                </view>
              </view>
              <view class="history-line-wrap" style="width: {{historyLineWidth}};">
                <view class="history-line-chart" style="width: {{historyLineWidth}}; height: {{historyChartHeight}};">
                  <view class="history-leading-hint" wx:if="{{historyLeadingHint}}">{{historyLeadingHint}}</view>
                  <view class="history-year-bar" wx:if="{{historyRenderMode === 'yearly'}}" wx:for="{{historyYearlyBars}}" wx:key="id" hidden="{{item.isEmpty}}" style="left: {{item.left}}; height: {{item.height}};"></view>
                  <view class="history-line-segment {{item.carried ? 'carried' : ''}}" wx:for="{{historyChartSegments}}" wx:key="id" style="left: {{item.left}}; top: {{item.top}}; width: {{item.width}}; transform: {{item.angle}};"></view>
                  <view class="history-line-dot {{item.carried ? 'carried' : ''}}" wx:for="{{historyChartPoints}}" wx:key="id" hidden="{{item.isEmpty}}" style="left: {{item.xPos}}; top: {{item.yPos}};"></view>
                </view>
                <view class="history-line-labels {{selectedHistoryDays > 7 ? 'compact' : ''}}" style="width: {{historyLineWidth}};">
                  <view class="history-point-item {{selectedHistoryDays > 7 ? 'compact' : ''}}" wx:for="{{historyChartPoints}}" wx:key="id">
                    <view class="history-point-value {{selectedHistoryDays > 7 ? 'compact' : ''}}">{{item.valueText}}</view>
                    <view class="history-point-day {{selectedHistoryDays > 7 ? 'compact' : ''}}">{{item.day}}</view>
                  </view>
                </view>
              </view>
              </view>
            </scroll-view>
          </view>

          <view class="history-detail-toggle" bindtap="toggleHistoryDetail">
            {{showHistoryDetail ? '收起历史明细' : '展开历史明细'}}
          </view>

          <view class="history-list" wx:if="{{showHistoryDetail}}">
            <view class="history-item" wx:for="{{historyList}}" wx:key="id">
              <view class="history-primary">
                <view class="history-date">{{item.date}}</view>
                <view class="history-tags">
                  <text class="history-tag">身高 {{item.height}}cm</text>
                  <text class="history-tag">体重 {{item.weight}}kg</text>
                  <text class="history-tag">血糖 {{item.bloodSugar || '--'}}mmol/L</text>
                  <text class="history-tag">心率 {{item.heartRate || '--'}}次/分</text>
                  <text class="history-tag">活动 {{item.activityLevelText}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="history-empty" wx:else>
          <text>暂无历史记录</text>
        </view>
      </view>
    </view>

    <view wx:elif="{{healthMainTab === 'evaluation'}}" class="eval-detail-panel" id="eval-detail-anchor">
      <view class="eval-detail-loading" wx:if="{{evalDetailLoading}}">加载中…</view>
      <view class="eval-detail-error" wx:elif="{{evalDetailError}}">{{evalDetailError}}</view>
      <block wx:elif="{{evaluationId}}">
        <view class="eval-detail-section">
          <view class="eval-detail-section-title">评估概览</view>
          <view class="eval-meta-row">
            <text>评估编号：{{evalDetail.evaluation_id}}</text>
          </view>
          <view class="eval-meta-row">
            <text>评估时间：{{evalDetail.createdAtText}}</text>
          </view>
          <view class="eval-meta-row" wx:if="{{evalDetail.validUntilText}}">
            <text>有效期至：{{evalDetail.validUntilText}}</text>
            <text class="eval-meta-tag {{evalDetail.expired ? 'expired' : ''}}">{{evalDetail.expired ? '已过期' : '有效'}}</text>
          </view>
          <view class="eval-meta-row" wx:if="{{evalDetail.bmi != null && evalDetail.bmi !== ''}}">
            <text>参考 BMI：{{evalDetail.bmi}}</text>
          </view>
          <view class="eval-meta-row" wx:if="{{evalDetail.nutritionStatusText}}">
            <text>营养状态：{{evalDetail.nutritionStatusText}}</text>
          </view>
          <view class="eval-meta-row" wx:if="{{evalDetail.energyNeedKcal}}">
            <text>估算日能量：{{evalDetail.energyNeedKcal}} kcal</text>
          </view>
        </view>

        <view class="eval-detail-section" wx:if="{{evalDetail.priorityIssues && evalDetail.priorityIssues.length}}">
          <view class="eval-detail-section-title">主要问题</view>
          <view class="eval-priority-item" wx:for="{{evalDetail.priorityIssues}}" wx:key="*this">{{item}}</view>
        </view>

        <view class="eval-detail-section" wx:if="{{evalDetail.body_composition_text}}">
          <view class="eval-detail-section-title">体成分与 BMI</view>
          <view class="eval-block-text">{{evalDetail.body_composition_text}}</view>
        </view>

        <view class="eval-detail-section" wx:if="{{evalDetail.dietary_pattern_text}}">
          <view class="eval-detail-section-title">饮食结构</view>
          <view class="eval-block-text">{{evalDetail.dietary_pattern_text}}</view>
        </view>

        <view class="eval-detail-section" wx:if="{{evalDetail.micronutrient_text}}">
          <view class="eval-detail-section-title">微量营养素与纤维</view>
          <view class="eval-block-text">{{evalDetail.micronutrient_text}}</view>
        </view>

        <view class="eval-detail-section" wx:if="{{evalDetail.risks_text}}">
          <view class="eval-detail-section-title">风险与禁忌</view>
          <view class="eval-block-text">{{evalDetail.risks_text}}</view>
        </view>

        <view class="eval-detail-section">
          <view class="eval-detail-section-title">专业评估结论</view>
          <view class="eval-block-text">{{evalDetail.professional_conclusion}}</view>
        </view>

        <view class="eval-detail-section" wx:if="{{evalDetail.plan_recommendations}}">
          <view class="eval-detail-section-title">对膳食计划的建议</view>
          <view class="eval-block-text">{{evalDetail.plan_recommendations}}</view>
        </view>
      </block>
      <view class="eval-detail-empty" wx:else>
        <text>暂无专业营养评估</text>
        <text class="eval-detail-empty-tip">规划师完成评估后，将在此展示完整报告；您也可从「膳食计划」跳转至本页。</text>
      </view>
    </view>

    <view wx:else class="edu-tab-panel">
      <view class="edu-toolbar">
        <view class="edu-filter {{heUserFilter === 'all' ? 'on' : ''}}" bindtap="setHeUserFilter" data-v="all">全部</view>
        <view class="edu-filter {{heUserFilter === 'public' ? 'on' : ''}}" bindtap="setHeUserFilter" data-v="public">公开</view>
        <view class="edu-filter {{heUserFilter === 'assigned' ? 'on' : ''}}" bindtap="setHeUserFilter" data-v="assigned">指派</view>
      </view>
      <view wx:if="{{heEduHint}}" class="edu-hint">{{heEduHint}}</view>
      <view wx:if="{{heEduLoading}}" class="edu-loading">加载中…</view>
      <view class="edu-list" wx:else>
        <view
          wx:for="{{heUserListDisplay}}"
          wx:key="he_id"
          class="edu-item"
          bindtap="openHeDetail"
          data-id="{{item.he_id}}"
        >
          <view class="edu-item-top">
            <text class="edu-item-title">{{item.title}}</text>
            <text class="edu-item-tag {{item.visibility}}">{{item.visibilityLabel}}</text>
          </view>
          <text class="edu-item-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
          <view class="edu-item-meta">
            <text class="edu-item-author">{{item.dietitian_name || '规划师'}}</text>
            <text class="edu-item-time">{{item.updated_at_text}}</text>
          </view>
        </view>
        <view wx:if="{{!heUserListDisplay.length}}" class="edu-empty">暂无健康教育内容</view>
      </view>
    </view>

    <!-- 基本信息编辑模态框 -->
    <view class="edit-modal" wx:if="{{showBasicInfoModal}}">
      <view class="modal-mask" bindtap="hideBasicInfoModal"></view>
      <view class="modal-content">
        <view class="modal-header">
          <view class="modal-title">{{isEditing ? '编辑' : '录入'}}基本信息</view>
          <view class="modal-close" bindtap="hideBasicInfoModal">×</view>
        </view>
        <view class="modal-body">
          <view class="form-item">
            <view class="form-label">性别</view>
            <view class="switch-container">
              <text class="gender-label {{formData.gender === '男' ? 'active' : ''}}">男</text>
              <view class="switch-selector" bindtap="toggleGender">
                <view class="switch-track">
                  <view class="switch-thumb {{formData.gender === '女' ? 'right' : ''}}"></view>
                </view>
              </view>
              <text class="gender-label {{formData.gender === '女' ? 'active' : ''}}">女</text>
            </view>
          </view>
          <view class="form-item">
            <view class="form-label">年龄</view>
            <input class="form-input" type="number" placeholder="请输入年龄" value="{{formData.age}}" bindinput="bindAgeInput" />
          </view>
          <view class="form-item">
            <view class="form-label">活动水平</view>
            <picker bindchange="changeActivityLevel" value="{{activityLevelIndex}}" range="{{activityLevelRange}}">
              <view class="picker-view {{activityLevelIndex < 0 ? 'picker-placeholder' : ''}}">
                {{activityLevelIndex < 0 ? '请选择活动水平' : activityLevelRange[activityLevelIndex]}}
              </view>
            </picker>
          </view>
          <view class="form-item">
            <view class="form-label">营养目标</view>
            <picker bindchange="changeNutritionGoal" value="{{nutritionGoalIndex}}" range="{{nutritionGoalRange}}">
              <view class="picker-view {{nutritionGoalIndex < 0 ? 'picker-placeholder' : ''}}">
                {{nutritionGoalIndex < 0 ? '请选择营养目标' : nutritionGoalRange[nutritionGoalIndex]}}
              </view>
            </picker>
          </view>
        </view>
        <view class="modal-footer">
          <button class="btn-cancel" bindtap="hideBasicInfoModal">取消</button>
          <button class="btn-confirm" bindtap="saveBasicInfo">保存</button>
        </view>
      </view>
    </view>

    <!-- 健康指标编辑模态框 -->
    <view class="edit-modal" wx:if="{{showHealthMetricsModal}}">
      <view class="modal-mask" bindtap="hideHealthMetricsModal"></view>
      <view class="modal-content">
        <view class="modal-header">
          <view class="modal-title">{{isEditing ? '编辑' : '录入'}}健康指标</view>
          <view class="modal-close" bindtap="hideHealthMetricsModal">×</view>
        </view>
        <view class="modal-body">
          <view class="form-item">
            <view class="form-label">身高 (cm)</view>
            <input class="form-input" type="digit" placeholder="请输入身高" value="{{formData.height}}" bindinput="bindHeightInput" />
          </view>
          <view class="form-item">
            <view class="form-label">体重 (kg)</view>
            <input class="form-input" type="digit" placeholder="请输入体重" value="{{formData.weight}}" bindinput="bindWeightInput" />
          </view>
          <view class="form-item">
            <view class="form-label">心率 (次/分)</view>
            <input class="form-input" type="number" placeholder="请输入心率" value="{{formData.heartRate}}" bindinput="bindHeartRateInput" />
          </view>
          <view class="form-item">
            <view class="form-label">血压 (mmHg)</view>
            <input class="form-input" type="text" placeholder="格式120/80（收缩压70-250，舒张压40-150）" value="{{formData.bloodPressure}}" bindinput="bindBloodPressureInput" />
          </view>
          <view class="form-item">
            <view class="form-label">血糖 (mmol/L)</view>
            <input class="form-input" type="digit" placeholder="请输入血糖值" value="{{formData.bloodSugar}}" bindinput="bindBloodSugarInput" />
          </view>
          <view class="form-item">
            <view class="form-label">过敏病史</view>
            <input class="form-input" type="text" placeholder="请输入过敏史，无则填无" value="{{formData.allergyHistory}}" bindinput="bindAllergyInput" />
          </view>
        </view>
        <view class="modal-footer">
          <button class="btn-cancel" bindtap="hideHealthMetricsModal">取消</button>
          <button class="btn-confirm" bindtap="saveHealthMetrics">保存</button>
        </view>
      </view>
    </view>
  </block>
</view>
