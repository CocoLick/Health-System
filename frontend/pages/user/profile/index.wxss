.container {
  min-height: 100vh;
  padding: 28rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: transparent;
}

.user-info {
  display: flex;
  align-items: center;
}

.header-card {
  margin-bottom: 18rpx;
  padding: 26rpx 22rpx;
  background: var(--c-surface);
  border-radius: 24rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.avatar {
  width: 102rpx;
  height: 102rpx;
  border-radius: 50%;
  background: #e8f7ef;
  border: 2px solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #067647;
  font-weight: 700;
}

.info {
  flex: 1;
  min-width: 0;
}

.username {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1c1e;
  margin-bottom: 8rpx;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #64748b;
  font-size: 20rpx;
}

.menu-card {
  background: var(--c-surface);
  border-radius: 24rpx;
  padding: 2rpx 16rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid rgba(26, 26, 26, 0.08);
}

.menu-item-hover {
  background: #f8fafc;
  transition: background-color 0.15s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.menu-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.menu-icon {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}

.menu-text {
  font-size: 30rpx;
  color: #1a1c1e;
}

.menu-arrow {
  font-size: 24rpx;
  color: #c3ced9;
}

.logout-section {
  margin-top: 32rpx;
}

.logout-btn {
  width: auto;
  min-width: 220rpx;
  height: 82rpx;
  line-height: 82rpx;
  background: var(--c-surface);
  color: #ef4444;
  font-size: 28rpx;
  border-radius: 20rpx;
  border: none;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  padding: 0 48rpx;
}

.about-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 24, 28, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  z-index: 1000;
  box-sizing: border-box;
}

.about-modal {
  width: 100%;
  max-width: 620rpx;
  background: var(--c-surface);
  border-radius: 20rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.about-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 8rpx;
}

.about-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
}

.about-close {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--c-text-3);
}

.about-body {
  padding: 8rpx 24rpx 18rpx;
}

.about-name {
  display: block;
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.about-version {
  display: inline-block;
  font-size: 22rpx;
  color: var(--c-primary);
  background: var(--c-primary-soft);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-bottom: 12rpx;
}

.about-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}

.about-foot {
  padding: 0 24rpx 24rpx;
}

.about-btn {
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  border-radius: 14rpx;
  color: #fff;
  background: var(--c-primary);
  font-size: 28rpx;
  font-weight: 600;
}
