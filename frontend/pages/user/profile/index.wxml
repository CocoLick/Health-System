<view class="container page-surface-bg">
  <view class="header-card">
    <view class="user-info">
      <view class="avatar">
        <text class="avatar-text">{{avatarInitial}}</text>
      </view>
      <view class="info">
        <view class="username">{{isLoggedIn ? (userInfo.username || '用户') : '请登录'}}</view>
        <view class="role-chip">{{isLoggedIn ? '普通用户' : '未登录'}}</view>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view
      class="menu-item"
      hover-class="menu-item-hover"
      hover-stay-time="90"
      wx:for="{{menuItems}}"
      wx:key="text"
      bindtap="handleMenuTap"
      data-path="{{item.path}}"
      data-action="{{item.action}}"
    >
      <view class="menu-left">
        <view class="menu-icon-wrap">
          <text class="menu-icon">{{item.icon}}</text>
        </view>
        <text class="menu-text">{{item.text}}</text>
      </view>
      <text class="menu-arrow">〉</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn" bindtap="handleAuthButtonTap">{{isLoggedIn ? '退出登录' : '去登录'}}</button>
  </view>

  <view wx:if="{{showAboutModal}}" class="about-mask" bindtap="closeAboutModal">
    <view class="about-modal" catchtap="stopPropagation">
      <view class="about-head">
        <text class="about-title">关于系统</text>
        <text class="about-close" bindtap="closeAboutModal">×</text>
      </view>
      <view class="about-body">
        <text class="about-name">个性化营养膳食智能规划系统</text>
        <text class="about-version">版本 v1.0</text>
        <text class="about-desc">以用户健康数据为基础，辅助生成更贴合日常的营养饮食建议与管理方案。</text>
      </view>
      <view class="about-foot">
        <view class="about-btn" bindtap="closeAboutModal">我知道了</view>
      </view>
    </view>
  </view>
</view>