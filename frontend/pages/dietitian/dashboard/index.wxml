<view class="dietitian-dashboard">
  <view class="dashboard-header">
    <text class="dashboard-title">👋 欢迎，营养师</text>
    <view class="user-info" bindtap="showPersonalCenter">
      <text class="welcome-text">{{dietitianName}}</text>
      <view class="user-avatar">营</view>
    </view>
  </view>

  <view class="custom-tab-bar">
    <view class="tab-item {{activeTab === 'home' ? 'active' : ''}}" bindtap="switchTab" data-tab="home">
      <text class="tab-icon">🏠</text>
      <text class="tab-text">工作台首页</text>
    </view>
    <view class="tab-item {{activeTab === 'service' ? 'active' : ''}}" bindtap="switchTab" data-tab="service">
      <text class="tab-icon">📋</text>
      <text class="tab-text">服务中心</text>
    </view>
    <view class="tab-item {{activeTab === 'feedback' ? 'active' : ''}}" bindtap="switchTab" data-tab="feedback">
      <text class="tab-icon">💬</text>
      <text class="tab-text">反馈中心</text>
    </view>
    <view class="tab-item {{activeTab === 'mine' ? 'active' : ''}}" bindtap="switchTab" data-tab="mine">
      <text class="tab-icon">👤</text>
      <text class="tab-text">我的</text>
    </view>
  </view>

  <view class="tab-content">
    <!-- 工作台首页 -->
    <view wx:if="{{activeTab === 'home'}}" class="content-panel">
      <view class="stats-overview">
        <view class="stat-card" bindtap="navigateToService">
          <view class="stat-icon plan-icon">📋</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.pendingPlans || 0}}</text>
            <text class="stat-label">待制定计划</text>
          </view>
        </view>
        <view class="stat-card" bindtap="navigateToHealthEducationTab">
          <view class="stat-icon article-icon">📄</view>
          <view class="stat-content">
            <text class="stat-number">{{heDraftCount}}</text>
            <text class="stat-label">健康教育草稿</text>
          </view>
        </view>
        <view class="stat-card" bindtap="navigateToFeedback">
          <view class="stat-icon feedback-icon">💬</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.pendingFeedbacks || 0}}</text>
            <text class="stat-label">待回复反馈</text>
          </view>
        </view>
        <view class="stat-card">
          <view class="stat-icon user-icon">👥</view>
          <view class="stat-content">
            <text class="stat-number">{{stats.serviceUsers || 0}}</text>
            <text class="stat-label">服务用户数</text>
          </view>
        </view>
      </view>

      <view class="home-service-feed">
        <text class="section-title">服务动态</text>
        <view class="feed-card">
          <view
            wx:for="{{homeServiceFeed}}"
            wx:key="requestId"
            class="feed-item"
            bindtap="onHomeFeedTap"
            data-id="{{item.requestId}}"
            hover-class="feed-item-hover"
          >
            <view class="feed-status feed-status--{{item.status}}">{{item.statusText}}</view>
            <view class="feed-body">
              <text class="feed-line1">{{item.serviceTypeText}}</text>
              <text class="feed-line2">用户 {{item.userId}}</text>
              <text class="feed-time">更新 · {{item.timeText}}</text>
            </view>
            <text class="feed-chev">›</text>
          </view>
          <view wx:if="{{homeServiceFeed.length === 0}}" class="empty-text">暂无服务申请记录，处理新申请后在此展示</view>
        </view>
      </view>

      <view class="system-notices">
        <text class="section-title">🔔 系统通知</text>
        <view class="notice-list">
          <view wx:for="{{notices}}" wx:key="index" class="notice-item">
            <view class="notice-icon">📢</view>
            <view class="notice-content">
              <text class="notice-title">{{item.title}}</text>
              <text class="notice-text">{{item.content}}</text>
              <text class="notice-time">{{item.time}}</text>
            </view>
          </view>
          <view wx:if="{{notices.length === 0}}" class="empty-text">暂无系统通知</view>
        </view>
      </view>
    </view>

    <!-- 服务中心 -->
    <view wx:if="{{activeTab === 'service'}}" class="content-panel">
      <!-- 子标签页 -->
      <view class="sub-tabs">
        <view class="sub-tab-item {{serviceSubTab === 'requests' ? 'active' : ''}}" bindtap="switchServiceSubTab" data-subtab="requests">
          <text class="sub-tab-text">服务申请</text>
          <view class="sub-tab-badge" wx:if="{{stats.pendingRequests > 0}}">{{stats.pendingRequests}}</view>
        </view>
        <view class="sub-tab-item {{serviceSubTab === 'users' ? 'active' : ''}}" bindtap="switchServiceSubTab" data-subtab="users">
          <text class="sub-tab-text">用户列表</text>
        </view>
        <view class="sub-tab-item {{serviceSubTab === 'education' ? 'active' : ''}}" bindtap="switchServiceSubTab" data-subtab="education">
          <text class="sub-tab-text">健康教育</text>
        </view>
      </view>

      <!-- 服务申请列表 -->
      <view wx:if="{{serviceSubTab === 'requests'}}" class="sub-tab-content">
        <!-- 申请管理模块 -->
        <view class="request-management">
          <view class="filter-tabs">
            <view class="filter-tab {{filterType === 'pending' ? 'active' : ''}}" bindtap="switchFilter" data-filter="pending">
              <text>待处理</text>
            </view>
            <view class="filter-tab {{filterType === 'approved' ? 'active' : ''}}" bindtap="switchFilter" data-filter="approved">
              <text>已通过</text>
            </view>
            <view class="filter-tab {{filterType === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-filter="all">
              <text>全部</text>
            </view>
          </view>

          <view class="request-list request-list--cards">
            <view wx:for="{{filteredRequests}}" wx:key="request_id" class="request-item request-item-card" bindtap="viewRequestDetail" data-index="{{index}}">
              <text class="request-card-eyebrow">服务申请</text>
              <view class="request-card-header">
                <view class="request-card-title-wrap">
                  <text class="request-card-title">{{item.serviceTypeText}}</text>
                  <view class="request-card-user">
                    <text class="request-avatar request-avatar-inline">{{item.user_initial}}</text>
                    <text class="request-card-username">{{item.user_id}}</text>
                  </view>
                </view>
                <text class="request-status request-status-inline {{item.status}}">{{item.statusText}}</text>
              </view>
              <view class="request-card-meta">
                <text class="request-card-time">提交于 {{item.createTimeText}}</text>
              </view>
              <view class="request-card-summary">
                <text class="request-card-summary-label">饮食目标</text>
                <text class="request-card-summary-text">{{item.dietGoalText}}</text>
              </view>
              <view class="request-card-extra" wx:if="{{item.other_goal}}">
                <text class="request-card-extra-label">补充说明</text>
                <text class="request-card-snippet">{{item.other_goal}}</text>
              </view>
              <view class="request-actions" catchtap="stopPropagation" wx:if="{{item.status === 'pending'}}">
                <view class="action-btn approve" bindtap="approveRequest" data-requestid="{{item.request_id}}">通过</view>
                <view class="action-btn reject" bindtap="rejectRequest" data-requestid="{{item.request_id}}">拒绝</view>
              </view>
              <view class="request-footer" wx:if="{{item.status !== 'pending'}}">
                <text class="request-action-text">查看详情</text>
              </view>
            </view>
            <view wx:if="{{filteredRequests.length === 0}}" class="empty-state">
              <text class="empty-icon">📋</text>
              <text class="empty-text">暂无服务申请</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 用户列表 -->
      <view wx:if="{{serviceSubTab === 'education'}}" class="sub-tab-content he-tab">
        <view class="he-toolbar">
          <view class="he-filter-row">
            <picker mode="selector" range="{{heStatusLabels}}" value="{{heStatusIndex}}" bindchange="onHeStatusPick">
              <view class="he-picker">状态：{{heStatusLabels[heStatusIndex]}}</view>
            </picker>
            <picker mode="selector" range="{{heVisLabels}}" value="{{heVisIndex}}" bindchange="onHeVisPick">
              <view class="he-picker">范围：{{heVisLabels[heVisIndex]}}</view>
            </picker>
          </view>
          <view class="he-new-btn" bindtap="navigateToHealthEducationNew">+ 新建</view>
        </view>
        <view class="he-list">
          <view wx:for="{{heFilteredList}}" wx:key="he_id" class="he-item" bindtap="openHealthEducationEdit" data-id="{{item.he_id}}">
            <view class="he-item-top">
              <text class="he-title">{{item.title}}</text>
              <text class="he-badge status-{{item.display_status_key || (item.content_status === 'draft' ? 'draft' : (item.audit_status === 'pending_review' ? 'pending_review' : (item.audit_status === 'rejected' ? 'rejected' : 'published')))}}">{{item.display_status_text || (item.content_status === 'draft' ? '草稿' : (item.audit_status === 'pending_review' ? '待审核' : (item.audit_status === 'rejected' ? '已驳回' : '已发布')))}}</text>
            </view>
            <view class="he-item-subline">
              <text class="he-time">更新于 {{item.updated_at}}</text>
              <text class="he-tag">{{item.visibility === 'assigned' ? '仅指派用户可见' : '公开可见'}}</text>
            </view>
            <text class="he-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
            <view class="he-reject-reason" wx:if="{{item.display_status_key === 'rejected' || item.audit_status === 'rejected'}}">
              <text class="he-reject-label">驳回原因</text>
              <text class="he-reject-text">{{item.reject_reason || item.review_note || '管理员未填写具体驳回原因，请修改后重新提交审核。'}}</text>
            </view>
            <view class="he-targets" wx:if="{{item.targetNamesText}}">
              <text class="he-targets-label">推送对象</text>
              <text class="he-targets-text">{{item.targetNamesText}}</text>
            </view>
            <view class="he-item-foot">
              <text class="he-item-action">查看并编辑</text>
            </view>
          </view>
          <view wx:if="{{heFilteredList.length === 0}}" class="empty-state">
            <text class="empty-icon">📄</text>
            <text class="empty-text">暂无健康教育内容</text>
          </view>
        </view>
      </view>

      <view wx:if="{{serviceSubTab === 'users'}}" class="sub-tab-content">
        <view class="service-users">
          <view class="search-box">
            <input class="search-input" placeholder="搜索用户..." bindinput="onSearchUser" value="{{searchKeyword}}"/>
          </view>

          <view class="user-list">
            <view wx:for="{{users}}" wx:key="index" class="user-item" bindtap="enterUserPanel" data-userid="{{item.userId}}">
              <view class="user-avatar-small">{{item.usernameInitial}}</view>
              <view class="user-info-small">
                <view class="user-item-head">
                  <text class="user-name">{{item.username}}</text>
                  <view class="user-enter-cta">
                    <text class="user-enter-text">进入服务</text>
                    <text class="user-enter-arrow">›</text>
                  </view>
                </view>
                <view class="user-status">
                  <text class="status-tag {{item.hasProfile ? 'status-ok' : 'status-warning'}}">{{item.hasProfile ? '档案 已完善' : '档案 待完善'}}</text>
                  <text class="status-tag {{item.hasEvaluation ? 'status-ok' : 'status-warning'}}">{{item.hasEvaluation ? '评估 已完成' : '评估 待完成'}}</text>
                  <text class="status-tag {{item.planStatusClass || (item.hasPlan ? 'status-ok' : 'status-warning')}}">{{item.planStatusText || (item.hasPlan ? '计划 已生成' : '计划 待生成')}}</text>
                </view>
                <text class="user-last-service">最后服务：{{item.lastServiceTime}}</text>
              </view>
            </view>
            <view wx:if="{{users.length === 0}}" class="empty-state">
              <text class="empty-icon">👥</text>
              <text class="empty-text">暂无用户数据</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 服务请求详情弹窗（与个人中心弹窗同一套视觉，避免旧 modal 样式） -->
    <view wx:if="{{showRequestDetail}}" class="modal-mask" bindtap="closeRequestDetail">
      <view class="personal-center-modal sr-request-detail-modal" catchtap="stopPropagation">
        <view class="pc-head">
          <view class="pc-head-left">
            <text class="pc-eyebrow">SERVICE REQUEST</text>
            <text class="pc-title">申请详情</text>
          </view>
          <view class="pc-close" bindtap="closeRequestDetail" hover-class="pc-close-press">×</view>
        </view>
        <scroll-view scroll-y class="sr-request-detail-scroll" wx:if="{{selectedRequest}}" show-scrollbar="{{false}}">
          <view class="sr-request-hero">
            <view class="sr-request-avatar">{{selectedRequest.user_initial || '?'}}</view>
            <view class="sr-request-hero-main">
              <text class="sr-request-userid">{{selectedRequest.user_id}}</text>
              <text class="request-status sr-request-status-pill {{selectedRequest.status}}">{{selectedRequest.statusText}}</text>
            </view>
          </view>
          <view class="sr-request-goal-card">
            <text class="sr-request-goal-label">饮食目标</text>
            <text class="sr-request-goal-text">{{selectedRequest.dietGoalText}}</text>
          </view>
          <view class="sr-request-extra" wx:if="{{selectedRequest.other_goal}}">
            <text class="sr-request-extra-label">补充说明</text>
            <text class="sr-request-extra-text">{{selectedRequest.other_goal}}</text>
          </view>
          <view class="sr-request-kv">
            <view class="sr-request-kv-row">
              <text class="sr-request-kv-k">服务类型</text>
              <text class="sr-request-kv-v">{{selectedRequest.serviceTypeText}}</text>
            </view>
            <view class="sr-request-kv-row">
              <text class="sr-request-kv-k">申请时间</text>
              <text class="sr-request-kv-v">{{selectedRequest.createTimeText}}</text>
            </view>
          </view>
          <view class="sr-request-health" wx:if="{{selectedRequest.health_data}}">
            <text class="sr-request-health-title">健康信息</text>
            <view class="sr-request-kv-row" wx:if="{{selectedRequest.health_data.disease}}">
              <text class="sr-request-kv-k">疾病史</text>
              <text class="sr-request-kv-v">{{selectedRequest.health_data.disease}}</text>
            </view>
            <view class="sr-request-kv-row" wx:if="{{selectedRequest.health_data.allergy}}">
              <text class="sr-request-kv-k">过敏食物</text>
              <text class="sr-request-kv-v">{{selectedRequest.health_data.allergy}}</text>
            </view>
            <view class="sr-request-kv-row" wx:if="{{selectedRequest.health_data.demand}}">
              <text class="sr-request-kv-k">特殊需求</text>
              <text class="sr-request-kv-v">{{selectedRequest.health_data.demand}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="sr-request-detail-footer" wx:if="{{selectedRequest && selectedRequest.status === 'pending'}}">
          <view class="modal-btn approve" bindtap="approveRequest" data-requestid="{{selectedRequest.request_id}}">批准申请</view>
          <view class="modal-btn reject" bindtap="rejectRequest" data-requestid="{{selectedRequest.request_id}}">拒绝申请</view>
        </view>
      </view>
    </view>

    <!-- 反馈中心 -->
    <view wx:if="{{activeTab === 'feedback'}}" class="content-panel">
      <view class="feedback-tabs">
        <view class="feedback-tab {{feedbackSubTab === 'pending' ? 'active' : ''}}" bindtap="switchFeedbackSubTab" data-subtab="pending">
          <text>待回复</text>
          <text class="badge" wx:if="{{pendingFeedbackCount > 0}}">{{pendingFeedbackCount}}</text>
        </view>
        <view class="feedback-tab {{feedbackSubTab === 'replied' ? 'active' : ''}}" bindtap="switchFeedbackSubTab" data-subtab="replied">
          <text>已回复</text>
        </view>
      </view>

      <view class="feedback-list">
        <view wx:for="{{feedbacks}}" wx:key="feedback_id" class="feedback-item" bindtap="viewFeedbackDetail" data-id="{{item.feedback_id}}">
          <view class="feedback-header">
            <view class="feedback-title-wrap">
              <text class="feedback-title">{{item.title}}</text>
              <view class="feedback-user">
                <text class="feedback-avatar">{{item.user_initial}}</text>
                <text class="feedback-username">{{item.username}}</text>
              </view>
            </view>
            <text class="feedback-status {{item.status === 'pending' ? 'status-pending' : 'status-replied'}}">{{item.status_label}}</text>
          </view>
          <view class="feedback-meta">
            <text class="feedback-type">{{item.category_label}}</text>
            <text class="feedback-time">{{item.display_time}}</text>
          </view>
          <view class="feedback-body">
            <text class="feedback-content">{{item.content_preview}}</text>
          </view>
          <view class="feedback-footer">
            <text class="feedback-action">查看详情并回复</text>
          </view>
        </view>
        <view wx:if="{{feedbacks.length === 0}}" class="empty-state">
          <text class="empty-icon">💬</text>
          <text class="empty-text">暂无反馈数据</text>
        </view>
      </view>
    </view>

    <!-- 我的 -->
    <view wx:if="{{activeTab === 'mine'}}" class="content-panel">
      <view class="mine-header">
        <view class="personal-info-card">
          <view class="personal-avatar-large" bindtap="chooseAvatar">营</view>
          <view class="personal-details">
            <text class="personal-name-large">{{dietitianName}}</text>
            <text class="personal-role-large">{{profileData.title || '营养师'}}</text>
            <view class="personal-stats">
              <view class="stat-item">
                <text class="stat-number">{{stats.serviceUsers || 0}}</text>
                <text class="stat-label">服务用户</text>
              </view>
              <view class="stat-item">
                <text class="stat-number">{{stats.totalPlans || 0}}</text>
                <text class="stat-label">制定计划</text>
              </view>
              <view class="stat-item">
                <text class="stat-number">{{stats.avgRating || 0}}</text>
                <text class="stat-label">平均评分</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="mine-menu">
        <view class="menu-section">
          <text class="section-title">账户管理</text>
          <view class="menu-item" bindtap="editProfile">
            <text class="menu-icon">👤</text>
            <text class="menu-text">个人资料</text>
            <text class="menu-arrow">→</text>
          </view>
          <view class="menu-item" bindtap="changePassword">
            <text class="menu-icon">🔒</text>
            <text class="menu-text">修改密码</text>
            <text class="menu-arrow">→</text>
          </view>
        </view>

        <view class="menu-section">
          <text class="section-title">其他</text>
          <view class="menu-item" bindtap="viewAbout">
            <text class="menu-icon">ℹ️</text>
            <text class="menu-text">关于我们</text>
            <text class="menu-arrow">→</text>
          </view>
        </view>

        <view class="logout-section">
          <view class="logout-btn" bindtap="handleLogout">
            <text class="logout-icon">🚪</text>
            <text class="logout-text">退出登录</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人中心弹窗（与全站主色/管理员工作台统一） -->
  <view wx:if="{{showPersonalCenterModal}}" class="modal-mask" bindtap="hidePersonalCenter">
    <view class="personal-center-modal" catchtap="stopPropagation">
      <view class="pc-head">
        <view class="pc-head-left">
          <text class="pc-eyebrow">ACCOUNT</text>
          <text class="pc-title">个人中心</text>
        </view>
        <view class="pc-close" bindtap="hidePersonalCenter" hover-class="pc-close-press">×</view>
      </view>
      <view class="pc-body">
        <view class="pc-profile">
          <view class="pc-avatar" bindtap="chooseAvatar">营</view>
          <text class="pc-name">{{dietitianName}}</text>
          <text class="pc-role">营养师</text>
        </view>
        <view class="pc-list">
          <view class="pc-item" bindtap="editProfile" hover-class="pc-item-press">
            <view class="pc-item-main">
              <view class="pc-ico">资</view>
              <text class="pc-label">个人资料</text>
            </view>
            <text class="pc-chev">›</text>
          </view>
          <view class="pc-item" bindtap="changePassword" hover-class="pc-item-press">
            <view class="pc-item-main">
              <view class="pc-ico">密</view>
              <text class="pc-label">修改密码</text>
            </view>
            <text class="pc-chev">›</text>
          </view>
          <view class="pc-item pc-item--danger" bindtap="handleLogout" hover-class="pc-item-press">
            <view class="pc-item-main">
              <view class="pc-ico pc-ico--out">出</view>
              <text class="pc-label">退出登录</text>
            </view>
            <text class="pc-chev">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showProfileEditor}}" class="modal-mask" bindtap="closeProfileEditor">
    <view class="request-detail-modal profile-edit-modal" catchtap="stopPropagation">
      <view class="modal-header profile-modal-header">
        <text class="modal-title profile-modal-title">编辑个人资料</text>
        <view class="modal-close profile-modal-close" bindtap="closeProfileEditor">✕</view>
      </view>
      <view class="modal-body profile-modal-body">
        <view class="profile-grid">
          <view class="field-row">
            <text class="field-label">账号ID</text>
            <view class="readonly-input-wrap">
              <text class="readonly-lock">🔒</text>
              <input class="form-input readonly" value="{{profileData.account_id}}" disabled />
            </view>
          </view>
          <view class="field-row">
            <text class="field-label">登录名</text>
            <view class="readonly-input-wrap">
              <text class="readonly-lock">🔒</text>
              <input class="form-input readonly" value="{{profileData.username}}" disabled />
            </view>
          </view>
          <view class="field-row">
            <text class="field-label">姓名 <text class="required-mark">*</text></text>
            <input class="form-input" value="{{profileForm.name}}" data-field="name" bindinput="onProfileInput" maxlength="100" placeholder="请输入姓名" placeholder-class="profile-input-placeholder" />
          </view>
          <view class="field-row">
            <text class="field-label">职称 <text class="required-mark">*</text></text>
            <input class="form-input" value="{{profileForm.title}}" data-field="title" bindinput="onProfileInput" maxlength="100" placeholder="请输入职称" placeholder-class="profile-input-placeholder" />
          </view>
          <view class="field-row">
            <text class="field-label">擅长方向 <text class="required-mark">*</text></text>
            <view class="tag-editor">
              <view class="tag-list">
                <view class="tag-chip" wx:for="{{profileSpecialtyTags}}" wx:key="index">
                  <text class="tag-chip-text">{{item}}</text>
                  <text class="tag-chip-remove" bindtap="removeProfileSpecialtyTag" data-index="{{index}}">×</text>
                </view>
              </view>
              <input
                class="tag-input"
                value="{{profileSpecialtyInput}}"
                data-field="specialty"
                bindinput="onProfileInput"
                bindconfirm="addProfileSpecialtyTag"
                maxlength="20"
                placeholder="输入擅长方向后回车，如：临床营养"
                placeholder-class="profile-input-placeholder"
              />
              <view class="tag-hint">回车添加，最多5项，单项最多20字</view>
            </view>
          </view>
          <view class="field-row">
            <text class="field-label">个人简介</text>
            <textarea class="form-input form-textarea" value="{{profileForm.introduction}}" data-field="introduction" bindinput="onProfileInput" maxlength="500" placeholder="请输入个人简介" placeholder-class="profile-input-placeholder" />
          </view>
          <view class="field-row">
            <text class="field-label">联系方式 <text class="required-mark">*</text></text>
            <input class="form-input" value="{{profileForm.contact}}" data-field="contact" bindinput="onProfileInput" maxlength="50" placeholder="请输入手机号或邮箱" placeholder-class="profile-input-placeholder" />
          </view>
        </view>
      </view>
      <view class="modal-footer profile-modal-footer">
        <view class="profile-btn profile-btn-cancel" bindtap="closeProfileEditor">取消</view>
        <view class="profile-btn profile-btn-save" bindtap="submitProfileEdit">保存</view>
      </view>
    </view>
  </view>
</view>