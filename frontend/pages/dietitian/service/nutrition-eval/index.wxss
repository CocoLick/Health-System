.page {
  min-height: 100vh;
  background: transparent;
  padding: 10rpx 0 40rpx;
}

.header {
  background: transparent;
  padding: 20rpx 30rpx 12rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--c-text);
}

.sub {
  font-size: 24rpx;
  color: var(--c-text-2);
  margin-top: 8rpx;
  line-height: 1.5;
}

.section {
  margin: 20rpx;
  background: var(--c-surface);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--c-border);
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(40, 38, 34, 0.08);
}

.hint {
  font-size: 22rpx;
  color: var(--c-text-2);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.ctx-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-bottom: 20rpx;
}

.ctx-row .label {
  font-size: 24rpx;
  color: var(--c-text-3);
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.ctx-value {
  display: block;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.55;
  word-break: break-word;
}

.ctx-core-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-3);
  line-height: 1.5;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.9);
  border: 1rpx dashed rgba(40, 38, 34, 0.12);
}

.accordion-tools {
  margin: 0 20rpx 6rpx;
  display: flex;
  justify-content: flex-end;
}

.accordion-tool-btn {
  font-size: 22rpx;
  color: var(--c-text-2);
  background: #f6f3ee;
  border: 1rpx solid var(--c-border);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.accordion-section {
  padding-top: 18rpx;
}

.section-title-accordion {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-arrow {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 500;
}

.field-label {
  font-size: 24rpx;
  color: var(--c-text-2);
  margin: 16rpx 0 8rpx;
  font-weight: 600;
}

.input, .textarea {
  width: 100%;
  box-sizing: border-box;
  font-size: 26rpx;
  padding: 16rpx;
  background: #fffcf8;
  border-radius: 12rpx;
  border: 1rpx solid var(--c-border);
}

.textarea {
  min-height: 140rpx;
}

.textarea-lg {
  min-height: 200rpx;
}

.picker {
  padding: 16rpx;
  background: #fffcf8;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--c-text);
  border: 1rpx solid var(--c-border);
}

.submit-bar {
  padding: 24rpx 30rpx;
}

.submit-spacer {
  height: 140rpx;
}

.submit-bar-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(255, 249, 241, 0.94);
  backdrop-filter: blur(8rpx);
  border-top: 1rpx solid rgba(40, 38, 34, 0.12);
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  background: var(--c-primary);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: 44rpx;
  box-shadow: 0 6rpx 16rpx rgba(45, 106, 79, 0.2);
}

.d7-hint {
  font-size: 22rpx;
  color: var(--c-text-2);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.d7-muted {
  color: var(--c-text-3);
}

.d7-warn {
  color: #b45309;
}

.d7-filters {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.d7-filter {
  flex: 1;
  min-width: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.d7-filter-label {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 600;
}

.d7-picker-line {
  font-size: 26rpx;
  color: var(--c-text);
  background: #fffcf8;
  border: 1rpx solid var(--c-border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.d7-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(40, 38, 34, 0.08);
}

.d7-row:active {
  opacity: 0.75;
}

.d7-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.d7-dt {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}

.d7-sub {
  font-size: 22rpx;
  color: var(--c-text-3);
}

.d7-right-macro {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  max-width: 60%;
  flex-shrink: 0;
}

.d7-macro-k {
  font-size: 26rpx;
  color: var(--c-text-2);
  font-variant-numeric: tabular-nums;
  line-height: 1.35;
}

.d7-macro-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-3);
  line-height: 1.35;
  word-break: break-word;
  font-variant-numeric: tabular-nums;
}

.d7-macro-na {
  font-size: 26rpx;
  color: var(--c-text-3);
  padding-top: 4rpx;
}

.d7-day-total {
  padding: 12rpx 0 8rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(40, 38, 34, 0.1);
}

.d7-day-total-title {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.d7-day-total-k {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.d7-day-total-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  word-break: break-word;
}

.d7-meal-macro {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--c-text-2);
  line-height: 1.45;
  font-variant-numeric: tabular-nums;
  word-break: break-word;
  padding-bottom: 4rpx;
}

.chart-block {
  margin-top: 16rpx;
  padding-top: 8rpx;
}

.chart-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 12rpx;
}

.chart-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.chart-title-side {
  font-size: 22rpx;
  color: var(--c-text-3);
  white-space: nowrap;
}

.chart-inline-summary {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--c-text-2);
  line-height: 1.5;
}

.chart-inline-summary-line {
  display: block;
}

.chart-scroll {
  white-space: nowrap;
}

.line-chart-row {
  display: flex;
  align-items: flex-start;
}

.line-y-axis {
  position: relative;
  width: 96rpx;
  height: 140rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.line-y-tick {
  position: absolute;
  left: 0;
  width: 100%;
  transform: translateY(-50%);
}

.line-y-text {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  text-align: right;
  font-size: 19rpx;
  color: #8e8e93;
}

.line-y-grid {
  position: absolute;
  left: 62rpx;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  border-top: 1rpx dashed rgba(142, 142, 147, 0.35);
}

.line-chart-wrap {
  display: inline-block;
  min-width: max-content;
}

.line-chart-core {
  position: relative;
  border-radius: 8rpx;
  background: var(--u-bg-soft, #f9fafb);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.line-segment {
  position: absolute;
  height: 3rpx;
  background: #07c160;
  transform-origin: left center;
  z-index: 1;
}

.line-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.12);
  z-index: 2;
}

.line-labels {
  display: flex;
  gap: 0;
  margin-top: 8rpx;
  width: 100%;
  flex-wrap: nowrap;
}

.line-label-item {
  width: 72rpx;
  flex: 0 0 72rpx;
}

.line-value {
  font-size: 18rpx;
  color: var(--c-text-3);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.line-day {
  margin-top: 6rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--c-text-3);
  font-variant-numeric: tabular-nums;
}

.nutri-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.nutri-label {
  width: 84rpx;
  font-size: 23rpx;
  color: var(--c-text-2);
}

.nutri-bar-bg {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  overflow: hidden;
}

.nutri-bar-fill {
  height: 100%;
  border-radius: 999rpx;
}

.nutri-pct {
  width: 78rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--c-text-2);
}

.nutri-compare-wrap {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(40, 38, 34, 0.08);
}

.nutri-compare-title {
  font-size: 22rpx;
  color: var(--c-text-2);
  margin-bottom: 8rpx;
}

.nutri-compare-row {
  margin-bottom: 14rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx dashed rgba(40, 38, 34, 0.06);
}

.nutri-compare-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.nutri-compare-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--c-text-2);
}

.nutri-compare-values {
  font-size: 22rpx;
  color: var(--c-text-3);
  font-variant-numeric: tabular-nums;
}

.nutri-compare-bars {
  width: 100%;
}

.nutri-compare-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.nutri-compare-tag {
  width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  text-align: center;
  font-size: 18rpx;
  border-radius: 6rpx;
  color: #fff;
  background: #2f855a;
}

.nutri-compare-tag.rec {
  background: #64748b;
}

.nutri-bar-fill.rec {
  opacity: 0.55;
}

.nutri-compare-delta {
  display: block;
  width: 100%;
  text-align: left;
  font-size: 22rpx;
  color: var(--c-text-2);
  margin-top: 2rpx;
  font-variant-numeric: tabular-nums;
}

.nutri-compare-delta.up {
  color: #b45309;
}

.nutri-compare-delta.down {
  color: #0369a1;
}

.tab-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.tab-row-days {
  margin-bottom: 12rpx;
}

.tab-item {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f5f6;
  color: var(--c-text-2);
  font-size: 22rpx;
}

.tab-item.on {
  background: rgba(7, 193, 96, 0.15);
  color: #0a5b34;
  font-weight: 700;
}

/* Reuse user-side stable trend chart styles */
.history-line-row {
  display: flex;
  align-items: flex-start;
}

.history-y-axis {
  position: relative;
  width: 96rpx;
  height: 130rpx;
  margin-right: 10rpx;
  flex: 0 0 auto;
}

.history-y-tick {
  position: absolute;
  left: 0;
  width: 100%;
  transform: translateY(-50%);
}

.history-y-text {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  text-align: right;
  font-size: 19rpx;
  color: #8e8e93;
}

.history-y-grid {
  position: absolute;
  left: 62rpx;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  border-top: 1rpx dashed rgba(142, 142, 147, 0.35);
}

.history-line-wrap {
  position: relative;
  display: inline-block;
  min-width: max-content;
  padding: 0;
}

.history-line-chart {
  position: relative;
  width: 100%;
  height: 130rpx;
  border-radius: 8rpx;
  background: var(--u-bg-soft, #f9fafb);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.history-line-labels {
  display: flex;
  gap: 0;
  margin-top: 8rpx;
  width: 100%;
  flex-wrap: nowrap;
}

.history-point-item {
  width: 72rpx;
  flex: 0 0 72rpx;
}

.history-point-value {
  font-size: 18rpx;
  color: var(--c-text-3);
  text-align: center;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.history-point-day {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--c-text-3);
  font-variant-numeric: tabular-nums;
}

.history-line-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin-left: -6rpx;
  margin-top: -6rpx;
  border-radius: 50%;
  background: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.12);
  z-index: 2;
}

.history-line-segment {
  position: absolute;
  height: 3rpx;
  background: #07c160;
  transform-origin: left center;
  z-index: 1;
}

.d7-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 与屏幕四边留边，避免内容贴边、底部被 home indicator 裁切 */
  padding: 48rpx 40rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.d7-sheet {
  width: 100%;
  max-width: 100%;
  /* 与遮罩内边距一起，保证整卡落在可视区内 */
  max-height: 68vh;
  background: var(--c-surface);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 0 1 auto;
}

.d7-sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid rgba(40, 38, 34, 0.08);
  flex-shrink: 0;
}

.d7-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}

.d7-sheet-close {
  font-size: 40rpx;
  line-height: 1;
  color: var(--c-text-3);
  padding: 8rpx 12rpx;
}

.d7-body-native {
  position: relative;
  width: 100%;
  height: 50vh;
  max-height: 50vh;
  overflow: hidden;
}

.d7-body-native-inner {
  height: 100%;
  max-height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
  width: 100%;
  padding: 12rpx 0 0;
  padding-left: 28rpx;
  /* 为右侧滚动条与文字留出整列空间；长词强制换行 */
  padding-right: 16rpx;
  /* iOS 11+ safe area */
  padding-bottom: max(40rpx, constant(safe-area-inset-bottom));
  padding-bottom: max(40rpx, env(safe-area-inset-bottom));
}

.d7-meal {
  margin-top: 20rpx;
}

.d7-meal:first-child {
  margin-top: 0;
}

.d7-meal-block {
  margin-bottom: 6rpx;
}

.d7-meal-titlerow {
  width: 100%;
  box-sizing: border-box;
  padding-right: 0;
}

.d7-meal-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
  line-height: 1.45;
  word-wrap: break-word;
  word-break: break-all;
  padding-right: 12rpx;
}

.d7-meal-krow {
  display: block;
  margin-top: 2rpx;
  padding-left: 0;
  width: 100%;
  box-sizing: border-box;
  padding-right: 12rpx;
}

.d7-meal-k {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.4;
}

.d7-item {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.5;
  padding: 4rpx 0;
  padding-right: 12rpx;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  display: block;
  word-wrap: break-word;
  word-break: break-all;
  overflow-wrap: break-word;
}
